<UserControl x:Class="ApeRadar.Controls.PlayerRosterRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ApeRadar"
             xmlns:utils="clr-namespace:ApeRadar.Utils"
             xmlns:cvt="clr-namespace:ApeRadar.Utils.Converters"
             x:Name="Root" Focusable="False" IsTabStop="False"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <cvt:ShipTierConverter x:Key="ShipTier"/>
        <cvt:BattleDataAvailabilityConverter x:Key="BattleData"/>
        <cvt:PlayerNamesVisibilityConverter x:Key="PlayerNames"/>
        <cvt:WatchStatusColorConverter x:Key="WatchColor"/>
        <cvt:NoteVisibilityConverter x:Key="TextVisibility"/>
        <cvt:RosterBadgeBrushConverter x:Key="BadgeBrush"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <utils:ShipRelationBrushConverter x:Key="ShipRelationBrush"/>
        <utils:WidthReductionConverter x:Key="WidthReduction"/>
        <Style x:Key="IdentityLine" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMirrored, ElementName=Root}" Value="True">
                    <Setter Property="TextAlignment" Value="Right"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="7,2" ClipToBounds="True" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid x:Name="IdentityLineContainer" Grid.Row="0" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource IdentityLine}"
                       MaxWidth="{Binding ActualWidth, ElementName=IdentityLineContainer, Converter={StaticResource WidthReduction}, ConverterParameter=96}"
                       FontSize="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}, Path=EffectivePlayerFontSize}"
                       Foreground="{Binding Player.WatchStatus, Converter={StaticResource WatchColor}}"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Player.Name}">
                <Run Text="{Binding Player.ClanTag, Converter={StaticResource PlayerNames}}"/>
                <Run Text=" "/><Run Text="{Binding Player.Name, Converter={StaticResource PlayerNames}}"/>
            </TextBlock>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0" ToolTip="{Binding AllStatusToolTip}">
                <ItemsControl ItemsSource="{Binding VisibleStatusBadges}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="3" Padding="4,1" Margin="1,0" Opacity="{Binding Opacity}"
                                    Background="{Binding Severity, Converter={StaticResource BadgeBrush}, ConverterParameter=Background}"
                                    ToolTip="{Binding ToolTip}">
                                <TextBlock Text="{Binding DisplayText}" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{Binding Severity, Converter={StaticResource BadgeBrush}, ConverterParameter=Foreground}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border CornerRadius="3" Padding="4,1" Margin="1,0" Background="{StaticResource SurfaceMutedBrush}"
                        Visibility="{Binding HasOverflowBadges, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding AllStatusToolTip}">
                    <TextBlock Text="{Binding OverflowBadgeText}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Border>
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding Player.Karma, Converter={StaticResource BattleData}}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}"
                       FontFamily="{StaticResource NumericFontFamily}" Typography.NumeralAlignment="Tabular" VerticalAlignment="Top" Margin="4,0,0,0"/>
        </Grid>
        <Grid x:Name="ShipLineContainer" Grid.Row="1" ClipToBounds="True">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="HorizontalAlignment" Value="Left"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMirrored, ElementName=Root}" Value="True">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Style="{StaticResource IdentityLine}"
                           MaxWidth="{Binding ActualWidth, ElementName=ShipLineContainer, Converter={StaticResource WidthReduction}, ConverterParameter=25}"
                           FontSize="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}, Path=EffectivePlayerFontSize}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Player.ShipName}">
                    <Run Text="{Binding Player.ShipTier, Converter={StaticResource ShipTier}}"/><Run Text="  "/><Run Text="{Binding Player.ShipName}"/>
                </TextBlock>
                <utils:ShipTypeIconBadge ShipType="{Binding Player.ShipType}"
                                         TintBrush="{Binding Player.Relation, Converter={StaticResource ShipRelationBrush}}"
                                         Margin="5,0,0,0" Width="20" Height="20"/>
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding ContextPreview}" FontSize="10"
                   Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding ContextPreview}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource IdentityLine}">
                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}, Path=IsCompactRoster}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
