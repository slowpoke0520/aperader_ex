<UserControl x:Class="ApeRadar.Controls.PlayerMetricGroup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ApeRadar"
             xmlns:cvt="clr-namespace:ApeRadar.Utils.Converters"
             xmlns:vm="clr-namespace:ApeRadar.ViewModels"
             x:Name="Root" Focusable="False" IsTabStop="False"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <cvt:RosterMetricBrushConverter x:Key="MetricBrush"/>
        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumericFontFamily}"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Emphasis}" Value="{x:Static vm:RosterMetricEmphasis.Primary}">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="MetricItemTemplate">
            <Grid Opacity="{Binding Opacity}" ToolTip="{Binding ToolTip}" Margin="5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}, Path=EffectiveStatisticsFontSize}"
                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Grid.Column="1" Text="{Binding DisplayValue}" Foreground="{Binding Converter={StaticResource MetricBrush}}"
                           FontSize="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}, Path=EffectiveStatisticsFontSize}"
                           Style="{StaticResource MetricValueStyle}"/>
                <TextBlock Grid.Column="2" Text="{Binding WarningGlyph}" Foreground="{StaticResource WarningBrush}"
                           FontSize="10" FontWeight="SemiBold" Margin="3,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <ItemsControl ItemsSource="{Binding Items}" VerticalAlignment="Center" HorizontalAlignment="Stretch">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Vertical" VerticalAlignment="Center"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><StaticResource ResourceKey="MetricItemTemplate"/></ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
