<UserControl x:Class="ApeRadar.Controls.PlayerMetricGroup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ApeRadar"
             xmlns:cvt="clr-namespace:ApeRadar.Utils.Converters"
             xmlns:vm="clr-namespace:ApeRadar.ViewModels"
             x:Name="Root" Focusable="False" IsTabStop="False"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <cvt:RosterMetricBrushConverter x:Key="MetricBrush"/>
        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumericFontFamily}"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Emphasis}" Value="{x:Static vm:RosterMetricEmphasis.Primary}">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="MetricItemTemplate">
            <Grid Margin="3,0" Opacity="{Binding Opacity}" VerticalAlignment="Center" ClipToBounds="True" ToolTip="{Binding ToolTip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MetricLabel"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayValue}" Foreground="{Binding Converter={StaticResource MetricBrush}}"
                               FontSize="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}, Path=EffectiveStatisticsFontSize}"
                               TextTrimming="CharacterEllipsis" Style="{StaticResource MetricValueStyle}"/>
                    <TextBlock Text="{Binding WarningGlyph}" Foreground="{StaticResource WarningBrush}" FontSize="11" FontWeight="SemiBold" Margin="3,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <ItemsControl ItemsSource="{Binding Lines}" VerticalAlignment="Center" ClipToBounds="True" Grid.IsSharedSizeScope="True">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Grid MinHeight="18" ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ContentControl x:Name="PrimaryMetric" Grid.Column="0" Content="{Binding Items[0]}" ContentTemplate="{StaticResource MetricItemTemplate}" HorizontalContentAlignment="Stretch"/>
                    <ContentControl x:Name="SecondaryMetric" Grid.Column="1" Content="{Binding Items[1]}" ContentTemplate="{StaticResource MetricItemTemplate}" HorizontalContentAlignment="Stretch"/>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Items.Count}" Value="1">
                        <Setter TargetName="PrimaryMetric" Property="Grid.ColumnSpan" Value="2"/>
                        <Setter TargetName="SecondaryMetric" Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
