<UserControl x:Class="ApeRadar.Controls.NoteTagsControl" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Focusable="False" IsTabStop="False" FontSize="12"
             UseLayoutRounding="True" SnapsToDevicePixels="True" ClipToBounds="True">
    <UserControl.Resources>
        <ItemsPanelTemplate x:Key="WrappingTags"><WrapPanel/></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="CompactTags"><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ItemsControl x:Name="TagItems">
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Setter Property="ItemsPanel" Value="{StaticResource WrappingTags}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Compact, ElementName=Root}" Value="True">
                            <Setter Property="ItemsPanel" Value="{StaticResource CompactTags}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{Binding BackgroundColor}" CornerRadius="4" Padding="5,2" Margin="0,1,4,1" ToolTip="{Binding Text}">
                        <TextBlock Foreground="{Binding ForegroundColor}" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding Text}"/>
                                    <Setter Property="MaxWidth" Value="240"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Compact, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                            <Setter Property="Text" Value="{Binding CompactText}"/>
                                            <Setter Property="TextWrapping" Value="NoWrap"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="MaxWidth" Value="74"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="OverflowText" Grid.Column="1" FontWeight="SemiBold" Foreground="#455468" VerticalAlignment="Center" Margin="1,0,0,0" Visibility="Collapsed"/>
    </Grid>
</UserControl>
