<UserControl x:Class="ApeRadar.Controls.NoteTagsControl" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Focusable="False" IsTabStop="False" FontSize="12"
             UseLayoutRounding="True" SnapsToDevicePixels="True" ClipToBounds="True">
    <UserControl.Resources>
        <ItemsPanelTemplate x:Key="WrappingTags"><WrapPanel/></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="CompactTags"><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
    </UserControl.Resources>
    <Grid x:Name="RootLayout">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ItemsControl x:Name="TagItems">
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Setter Property="ItemsPanel" Value="{StaticResource WrappingTags}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Compact, ElementName=Root}" Value="True">
                            <Setter Property="ItemsPanel" Value="{StaticResource CompactTags}"/>
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Compact, ElementName=Root}" Value="True"/>
                                <Condition Binding="{Binding CompactRows, ElementName=Root}" Value="2"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="ItemsPanel" Value="{StaticResource WrappingTags}"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{Binding BackgroundColor}" CornerRadius="4" Margin="0,1,4,1" ToolTip="{Binding Text}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Padding" Value="5,2"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Compact, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                            <Condition Binding="{Binding CompactRows, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="2"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Padding" Value="3,0"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Foreground="{Binding ForegroundColor}" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding Text}"/>
                                    <Setter Property="MaxWidth" Value="240"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Compact, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                            <Setter Property="Text" Value="{Binding CompactText}"/>
                                            <Setter Property="TextWrapping" Value="NoWrap"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="MaxWidth" Value="74"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="OverflowText" FontWeight="SemiBold" Foreground="#455468" Visibility="Collapsed">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Grid.Column" Value="1"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Margin" Value="1,0,0,0"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Compact, ElementName=Root}" Value="True"/>
                                <Condition Binding="{Binding CompactRows, ElementName=Root}" Value="2"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Grid.Column" Value="0"/>
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="VerticalAlignment" Value="Bottom"/>
                            <Setter Property="Margin" Value="1,0,0,1"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
