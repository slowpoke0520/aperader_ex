<UserControl x:Class="ApeRadar.Controls.DashboardMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ApeRadar"
             xmlns:controls="clr-namespace:ApeRadar.Controls"
             xmlns:utils="clr-namespace:ApeRadar.Utils"
             xmlns:cvt="clr-namespace:ApeRadar.Utils.Converters"
             xmlns:p="clr-namespace:ApeRadar.Properties"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             x:Name="Root" UseLayoutRounding="True" SnapsToDevicePixels="True"
             PreviewKeyDown="Root_PreviewKeyDown" SizeChanged="Root_SizeChanged">
    <UserControl.Resources>
        <SolidColorBrush x:Key="DashboardBackground" Color="{StaticResource AppBackgroundColor}"/>
        <SolidColorBrush x:Key="DashboardSurface" Color="{StaticResource SurfaceColor}"/>
        <SolidColorBrush x:Key="DashboardBorder" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="DashboardText" Color="{StaticResource TextPrimaryColor}"/>
        <SolidColorBrush x:Key="DashboardMuted" Color="{StaticResource TextSecondaryColor}"/>
        <SolidColorBrush x:Key="RosterHorizontalDivider" Color="#D7E0EA"/>
        <SolidColorBrush x:Key="RosterVerticalDivider" Color="#D7E0EA"/>
        <SolidColorBrush x:Key="RosterHeaderDivider" Color="#D7E0EA"/>
        <SolidColorBrush x:Key="RosterCellDivider" Color="#D7E0EA"/>
        <SolidColorBrush x:Key="DashboardBlue" Color="#176ADE"/>
        <SolidColorBrush x:Key="DashboardRed" Color="#D92E49"/>
        <SolidColorBrush x:Key="DashboardAllySurface" Color="#EAF3FF"/>
        <SolidColorBrush x:Key="DashboardEnemySurface" Color="#FFF0F2"/>

        <cvt:RosterMetricBrushConverter x:Key="MetricBrush"/>
        <cvt:RosterBadgeBrushConverter x:Key="BadgeBrush"/>
        <cvt:ShipTierConverter x:Key="ShipTier"/>
        <cvt:LabelGamePathIsSetContentConverter x:Key="CvtGamePathIsSetText"/>
        <cvt:LabelGamePathIsSetColorConverter x:Key="CvtGamePathIsSetColor"/>
        <utils:ShipRelationBrushConverter x:Key="ShipRelationBrush"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <cvt:DataGridColumnVisibilityConverter x:Key="ColumnVisibility"/>
        <cvt:DashboardBadgeVisibilityConverter x:Key="BadgeVisibility"/>
        <cvt:DashboardBadgeOverflowConverter x:Key="BadgeOverflow"/>
        <cvt:NotificationMessageColorConverter x:Key="NotificationColor"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource DashboardSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DashboardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#41536D"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="NavButtonSelected" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Background" Value="#E6F0FF"/>
            <Setter Property="Foreground" Value="{StaticResource DashboardBlue}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D4DFEC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="FilterButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#F7F9FC"/>
            <Setter Property="BorderBrush" Value="#D8E1EC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="FilterButtonActive" TargetType="Button" BasedOn="{StaticResource FilterButton}">
            <Setter Property="Background" Value="#E3EEFF"/>
            <Setter Property="BorderBrush" Value="#7FB0F5"/>
            <Setter Property="Foreground" Value="#155CB5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SegmentButton" TargetType="Button" BasedOn="{StaticResource FilterButton}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="SegmentActive" TargetType="Button" BasedOn="{StaticResource SegmentButton}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource DashboardBlue}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="DashboardRosterCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="DashboardRosterHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="RosterGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource RosterHorizontalDivider}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource RosterVerticalDivider}"/>
            <Setter Property="CellStyle" Value="{StaticResource DashboardRosterCell}"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource DashboardRosterHeader}"/>
            <Setter Property="RowHeight" Value="56"/>
            <Setter Property="ColumnHeaderHeight" Value="28"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFD"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <EventSetter Event="ScrollViewer.ScrollChanged" Handler="RosterGrid_ScrollChanged"/>
        </Style>
        <Style x:Key="RosterRowStyle" TargetType="DataGridRow">
            <EventSetter Event="MouseEnter" Handler="RosterRow_MouseEnter"/>
            <EventSetter Event="MouseLeave" Handler="RosterRow_MouseLeave"/>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource DashboardText}"/>
        </Style>

        <DataTemplate x:Key="BadgeTemplate">
            <Border x:Name="BadgeBorder" CornerRadius="5" Height="22" Padding="6,0" Margin="2,0" VerticalAlignment="Center" MaxWidth="88"
                    Background="{Binding Severity, Converter={StaticResource BadgeBrush}, ConverterParameter=Background}"
                    ToolTip="{Binding ToolTip}">
                <Grid>
                <TextBlock x:Name="BadgeText" Text="{Binding DisplayText}" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Padding="0,0,0,1" TextOptions.TextFormattingMode="Display"
                           Foreground="{Binding Severity, Converter={StaticResource BadgeBrush}, ConverterParameter=Foreground}"/>
                <controls:NoteTagsControl x:Name="NoteTags" Note="{Binding NoteText}" Compact="True" MaximumVisibleTags="3" Visibility="Collapsed"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Note">
                    <Setter TargetName="BadgeText" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="NoteTags" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="BadgeBorder" Property="Background" Value="Transparent"/>
                    <Setter TargetName="BadgeBorder" Property="Padding" Value="0"/>
                    <Setter TargetName="BadgeBorder" Property="MaxWidth" Value="200"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="PlayerTemplate">
            <Grid x:Name="PlayerIdentityHost" Margin="8,4">
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource CellText}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding PlayerDisplayName}">
                    <Run Text="{Binding PlayerDisplayName, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding KarmaText, Mode=OneWay}" BaselineAlignment="Superscript" FontSize="12" FontWeight="Normal" Foreground="{StaticResource DashboardMuted}"/>
                </TextBlock>
                <Grid Grid.Row="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Player.ShipTier, Converter={StaticResource ShipTier}}" FontSize="12" Foreground="{StaticResource DashboardMuted}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Player.ShipName}" FontSize="12" Foreground="{StaticResource DashboardMuted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Player.ShipName}"/>
                    <ItemsControl Grid.Column="2" ItemsSource="{Binding VisibleStatusBadges}" ItemTemplate="{StaticResource BadgeTemplate}" Visibility="{Binding ActualWidth, ElementName=PlayerIdentityHost, Converter={StaticResource BadgeVisibility}}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Grid.Column="3" FontSize="12" Margin="4,0,0,0" Foreground="{StaticResource DashboardMuted}" VerticalAlignment="Center" ToolTip="{Binding AllStatusToolTip}">
                        <TextBlock.Text><MultiBinding Converter="{StaticResource BadgeOverflow}"><Binding Path="StatusBadges.Count"/><Binding Path="ActualWidth" ElementName="PlayerIdentityHost"/><Binding Path="VisibleStatusBadges.Count"/></MultiBinding></TextBlock.Text>
                    </TextBlock>
                </Grid>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ContextHeaderTemplate">
            <TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
        </DataTemplate>
        <DataTemplate x:Key="ShipHeaderTemplate">
            <TextBlock Text="{DynamicResource DashboardColumnCurrentShip}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
        </DataTemplate>
        <DataTemplate x:Key="ContextTemplate">
            <StackPanel VerticalAlignment="Center" Margin="4,3" ToolTip="{Binding ContextToolTip}">
                <TextBlock Text="{Binding ContextWinrateMetric.DisplayValue}" Foreground="{Binding ContextWinrateMetric, Converter={StaticResource MetricBrush}}" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource NumericFontFamily}" TextAlignment="Right"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Style="{StaticResource CellText}" FontSize="12"><Run Text="{Binding ContextBattlesText, Mode=OneWay}"/><Run Text=" "/><Run Text="{DynamicResource RosterMetricBattlesShort}"/></TextBlock>
                    <TextBlock Text="{Binding ContextWarning}" Foreground="{StaticResource WarningBrush}" FontSize="12" Margin="2,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ShipTemplate">
            <StackPanel VerticalAlignment="Center" Margin="4,3">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ShipWinrateMetric.DisplayValue}" Foreground="{Binding ShipWinrateMetric, Converter={StaticResource MetricBrush}}" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource NumericFontFamily}"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource CellText}" FontSize="12" TextAlignment="Right" Margin="3,0,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding ShipBattlesText}"><Run Text="{Binding ShipBattlesText, Mode=OneWay}"/><Run Text="{DynamicResource DashboardBattlesCompact}"/></TextBlock>
                </Grid>
                <TextBlock Style="{StaticResource CellText}" FontSize="12" TextAlignment="Right" Visibility="{Binding Source={x:Static p:Settings.Default}, Path=ShipAvgDmgVisibility, Converter={StaticResource ColumnVisibility}}"><Run Text="{DynamicResource RosterMetricAvgDamageShort}"/><Run Text=" "/><Run Text="{Binding ShipDamageText, Mode=OneWay}"/></TextBlock>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="PrTemplate">
            <StackPanel VerticalAlignment="Center" Margin="5">
                <TextBlock FontSize="12" TextAlignment="Right" Foreground="{Binding ContextPrMetric, Converter={StaticResource MetricBrush}}"><Run Text="{Binding ContextPrLabel, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding ContextPrMetric.DisplayValue, Mode=OneWay}"/></TextBlock>
                <TextBlock FontSize="12" TextAlignment="Right" Foreground="{Binding ShipPrMetric, Converter={StaticResource MetricBrush}}"><Run Text="{DynamicResource RosterPrShipShort}"/><Run Text=" "/><Run Text="{Binding ShipPrMetric.DisplayValue, Mode=OneWay}"/></TextBlock>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="PerformanceTemplate">
            <Grid ToolTip="{Binding Performance.ToolTip}" AutomationProperties.Name="{Binding Performance.AccessibleName}">
                <Border Width="3" Background="{Binding Performance.BackgroundColor}" HorizontalAlignment="Left" Margin="0,7"/>
                <Grid Margin="7,3,4,3" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="LegacyPerformanceIcon" Text="{Binding Performance.Icon}" Visibility="{Binding Performance.HasIcon, Converter={StaticResource BoolToVisibility}}" Opacity="{Binding Performance.IconOpacity}" FontFamily="Segoe UI Emoji, Segoe UI Symbol" FontSize="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PerformanceLabel" Grid.Column="1" Text="{Binding PerformanceDisplay}" Foreground="{Binding PerformanceLabelMetric, Converter={StaticResource MetricBrush}}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ScoreMetricTemplate">
            <StackPanel VerticalAlignment="Center" Margin="10,0" ToolTip="{Binding Label}">
                <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource DashboardMuted}" TextTrimming="CharacterEllipsis"/>
                <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding AllyText}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource DashboardBlue}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Direction}" Margin="5,0" FontSize="12" Foreground="{StaticResource DashboardMuted}"/>
                    <TextBlock Grid.Column="2" Text="{Binding EnemyText}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource DashboardRed}" TextAlignment="Right"/>
                </Grid>
                <TextBlock Text="{Binding CoverageText}" FontSize="12" Foreground="{StaticResource DashboardMuted}" ToolTip="{DynamicResource DashboardMetricCoverageTip}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource DashboardBackground}">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#F8FBFF" BorderBrush="#DEE7F1" BorderThickness="0,0,1,0">
            <Grid><Grid.RowDefinitions><RowDefinition x:Name="BrandRow" Height="72"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid x:Name="BrandHeaderGrid" Margin="14,12"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="17" Background="#E4EFFE"><TextBlock Text="⚓" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#1D4E89"/></Border>
                    <StackPanel x:Name="BrandText" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="ApeRadar EX" FontSize="16" FontWeight="Bold" Foreground="{StaticResource DashboardText}"/><TextBlock Text="{DynamicResource DashboardSubtitle}" FontSize="12" Foreground="{StaticResource DashboardMuted}" TextTrimming="None"/></StackPanel>
                </Grid>
                <StackPanel x:Name="NavigationButtons" Grid.Row="1" Margin="0,6,0,0">
                    <Button Style="{StaticResource NavButtonSelected}" ToolTip="{DynamicResource DashboardNavBattle}" AutomationProperties.Name="{DynamicResource DashboardNavBattle}"><StackPanel Orientation="Horizontal"><TextBlock Text="▥" FontSize="19" Width="32"/><TextBlock x:Name="NavBattleText" Text="{DynamicResource DashboardNavBattle}" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Click="History_Click" ToolTip="{DynamicResource BtnHistory}" AutomationProperties.Name="{DynamicResource BtnHistory}"><StackPanel Orientation="Horizontal"><TextBlock Text="◴" FontSize="18" Width="32"/><TextBlock x:Name="NavHistoryText" Text="{DynamicResource BtnHistory}" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Click="ToggleAnalysis_Click" ToolTip="{DynamicResource BtnAnalysis}" AutomationProperties.Name="{DynamicResource BtnAnalysis}"><StackPanel Orientation="Horizontal"><TextBlock Text="⌁" FontSize="20" Width="32"/><TextBlock x:Name="NavAnalysisText" Text="{DynamicResource BtnAnalysis}" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="OpenReplayButton" Style="{StaticResource NavButton}" Click="OpenReplay_Click" ToolTip="{DynamicResource BtnOpen}" AutomationProperties.Name="{DynamicResource BtnOpen}"><StackPanel Orientation="Horizontal"><TextBlock Text="▷" FontSize="20" Width="32"/><TextBlock x:Name="NavReplayText" Text="{DynamicResource BtnOpen}" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Click="Settings_Click" ToolTip="{DynamicResource BtnConfig}" AutomationProperties.Name="{DynamicResource BtnConfig}"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="18" Width="32"/><TextBlock x:Name="NavSettingsText" Text="{DynamicResource BtnConfig}" VerticalAlignment="Center"/></StackPanel></Button>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="10,8,10,16">
                    <Border x:Name="SessionCard" Style="{StaticResource Card}" Padding="8,6" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonDown="SessionCard_MouseLeftButtonDown" ToolTip="{Binding SessionToolTip, ElementName=Root}">
                        <StackPanel><TextBlock Text="{DynamicResource MainSessionTitle}" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="SessionText" Text="—" Foreground="{StaticResource DashboardMuted}" FontSize="12" TextWrapping="Wrap"/></StackPanel>
                    </Border>
                    <Button x:Name="CompactSessionButton" MinWidth="0" Content="◷" Style="{StaticResource FilterButton}" Visibility="Collapsed" ToolTip="{Binding SessionToolTip, ElementName=Root}" AutomationProperties.Name="{DynamicResource MainSessionTitle}" Click="History_Click"/>
                    <StackPanel x:Name="SidebarVersion" Margin="1,0,0,0"><TextBlock Text="{Binding Source={x:Static p:Settings.Default}, Path=SoftwareVersion, Mode=OneWay}" Foreground="{StaticResource DashboardMuted}" FontSize="12"/><TextBlock Foreground="{StaticResource DashboardMuted}" FontSize="12"><Run Text="{DynamicResource DashboardBuild}"/><Run Text=" "/><Run Text="{Binding Source={x:Static p:Settings.Default}, Path=SoftwareDate, Mode=OneWay}"/></TextBlock></StackPanel>
                    <Grid x:Name="SidebarLinks" Margin="0,7,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Button x:Name="UpdateNavButton" MinWidth="0" Content="{DynamicResource BtnSoftwareUpdate}" Style="{StaticResource FilterButton}" Margin="0,0,3,0" ToolTip="{DynamicResource BtnSoftwareUpdate}" AutomationProperties.Name="{DynamicResource BtnSoftwareUpdate}" Click="Update_Click"/>
                        <Button x:Name="HelpNavButton" MinWidth="0" Grid.Column="1" Content="{DynamicResource DashboardHelp}" Style="{StaticResource FilterButton}" Margin="3,0,0,0" ToolTip="{DynamicResource DashboardHelp}" AutomationProperties.Name="{DynamicResource DashboardHelp}" Click="Help_Click"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="White" BorderBrush="#E0E7F0" BorderThickness="0,0,0,1">
                <Grid Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource DashboardDataSource}" Foreground="{StaticResource DashboardMuted}" FontSize="12"/>
                        <TextBlock Text="{Binding Metadata.Provider}" Foreground="{StaticResource DashboardText}" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="   " FontSize="12"/><TextBlock Text="{DynamicResource DashboardLastUpdated}" Foreground="{StaticResource DashboardMuted}" FontSize="12"/>
                        <TextBlock Text="{Binding Metadata.UpdatedAtText}" Foreground="{StaticResource DashboardText}" FontSize="12"/>
                        <TextBlock Text="   " FontSize="12"/><TextBlock x:Name="GamePathStatusText" Text="{Binding Source={x:Static p:Settings.Default}, Path=GamePath, Converter={StaticResource CvtGamePathIsSetText}}" Foreground="{Binding Source={x:Static p:Settings.Default}, Path=GamePath, Converter={StaticResource CvtGamePathIsSetColor}}" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="StatusButton" Visibility="{Binding Status.IsVisible, ElementName=Root, Converter={StaticResource BoolToVisibility}}" Background="Transparent" BorderThickness="0" Click="Status_Click" ToolTip="{Binding Status.Text, ElementName=Root}"><StackPanel Orientation="Horizontal"><Ellipse Width="10" Height="10" Fill="{Binding Status.Accent, ElementName=Root}" Margin="0,0,7,0"/><TextBlock Text="{Binding Status.Text, ElementName=Root}" Foreground="#40516A" FontWeight="SemiBold" FontSize="12" MaxWidth="220" TextTrimming="CharacterEllipsis"/></StackPanel></Button>
                        <ComboBox x:Name="LanguageCombo" Width="88" Margin="12,0,0,0" SelectionChanged="LanguageCombo_SelectionChanged"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="MainContentGrid" Grid.Row="1" Margin="18,12,18,12">
                <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="106"/><RowDefinition Height="36"/><RowDefinition x:Name="RosterAreaRow" Height="*" MinHeight="80"/></Grid.RowDefinitions>
                <Grid x:Name="BattleHeading" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource DashboardCurrentBattle}" FontSize="23" FontWeight="Bold" Foreground="{StaticResource DashboardText}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="BattleMetadataText" Grid.Column="1" Margin="18,0,8,0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{StaticResource DashboardMuted}" FontSize="12" TextTrimming="CharacterEllipsis">
                        <Run Text="{DynamicResource DashboardMap}"/><Run Text="{Binding Metadata.MapName, Mode=OneWay}"/><Run Text="   |   "/><Run Text="{DynamicResource DashboardMode}"/><Run Text="{Binding Metadata.Mode, Mode=OneWay}"/><Run Text="   |   "/><Run Text="{DynamicResource DashboardServer}"/><Run Text="{Binding Metadata.Server, Mode=OneWay}"/><Run Text="   |   "/><Run Text="{DynamicResource DashboardStartedAt}"/><Run Text="{Binding Metadata.StartedAtText, Mode=OneWay}"/>
                    </TextBlock>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                        <Button x:Name="RefreshButton" Style="{StaticResource ToolbarButton}" Content="{DynamicResource BtnRefresh}" Click="Refresh_Click"/>
                        <Button Style="{StaticResource ToolbarButton}" Content="{DynamicResource DashboardSaveScreenshot}" Click="Screenshot_Click"/>
                    </StackPanel>
                </Grid>

                <Border x:Name="ComparisonCard" Grid.Row="1" Style="{StaticResource Card}" Height="98" Padding="6">
                    <Grid x:Name="ComparisonPanel"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <ContentControl Content="{Binding Summary.ContextWinrate}" ContentTemplate="{StaticResource ScoreMetricTemplate}"/>
                        <ContentControl Grid.Column="1" Content="{Binding Summary.ContextPr}" ContentTemplate="{StaticResource ScoreMetricTemplate}"/>
                        <ContentControl Grid.Column="2" Content="{Binding Summary.ShipWinrate}" ContentTemplate="{StaticResource ScoreMetricTemplate}"/>
                        <ContentControl Grid.Column="3" Content="{Binding Summary.ShipPr}" ContentTemplate="{StaticResource ScoreMetricTemplate}"/>
                    </Grid>
                </Border>

                <Grid x:Name="RosterToolbar" Grid.Row="2" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource DashboardDataContext}" Foreground="{StaticResource DashboardMuted}" FontSize="12" VerticalAlignment="Center" Margin="2,0,5,0"/>
                        <Border Background="#EFF3F8" BorderBrush="#D5DFEB" BorderThickness="1" CornerRadius="7" Padding="3"><StackPanel Orientation="Horizontal"><Button x:Name="AccountContext" Content="{DynamicResource DashboardContextAccount}" Tag="Account" Style="{StaticResource SegmentActive}" Click="Context_Click"/><Button x:Name="TierContext" Content="{DynamicResource DashboardContextTier}" Tag="Tier" Style="{StaticResource SegmentButton}" Click="Context_Click"/></StackPanel></Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource DashboardSortBy}" Foreground="{StaticResource DashboardMuted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="SortCombo" Width="190" Height="30" SelectionChanged="SortCombo_SelectionChanged"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="RosterTeamsGrid" Grid.Row="3" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Background="{StaticResource DashboardAllySurface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"><Grid Margin="10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Foreground="{StaticResource DashboardBlue}" FontSize="14.5" FontWeight="Bold" VerticalAlignment="Center"><Run Text="{DynamicResource LabelAllies}"/><Run Text=" ("/><Run Text="{Binding AllyTotalCount, Mode=OneWay}"/><Run Text=")"/></TextBlock><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="AllyAll" Tag="Ally:All" Style="{StaticResource FilterButtonActive}" Click="Filter_Click"/><Button x:Name="AllyMarked" Tag="Ally:Marked" Style="{StaticResource FilterButton}" Click="Filter_Click"/><Button x:Name="AllyLow" Tag="Ally:LowSample" Style="{StaticResource FilterButton}" Click="Filter_Click"/><Button x:Name="AllyAnomaly" Tag="Ally:Anomaly" Style="{StaticResource FilterButton}" Click="Filter_Click"/></StackPanel></Grid></Border>
                        <DataGrid x:Name="AlliesGrid" Grid.Row="1" Style="{StaticResource RosterGrid}" RowStyle="{StaticResource RosterRowStyle}" ItemsSource="{Binding Allies}" LoadingRow="RosterGrid_LoadingRow">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{DynamicResource DashboardColumnPlayer}" CellTemplate="{StaticResource PlayerTemplate}" Width="*" MinWidth="210"/>
                                <DataGridTemplateColumn x:Name="AllyContextColumn" Header="{DynamicResource DashboardContextAccount}" HeaderTemplate="{StaticResource ContextHeaderTemplate}" CellTemplate="{StaticResource ContextTemplate}" Width="90" MinWidth="90"/>
                                <DataGridTemplateColumn x:Name="AllyShipColumn" Header="{DynamicResource DashboardColumnCurrentShip}" HeaderTemplate="{StaticResource ShipHeaderTemplate}" CellTemplate="{StaticResource ShipTemplate}" Width="112" MinWidth="112"/>
                                <DataGridTemplateColumn x:Name="AllyPrColumn" Header="PR" CellTemplate="{StaticResource PrTemplate}" Width="94" MinWidth="94" Visibility="{Binding Source={x:Static p:Settings.Default}, Path=PRVisibility, Converter={StaticResource ColumnVisibility}}"/>
                                <DataGridTemplateColumn x:Name="AllyPerformanceColumn" Header="{DynamicResource DashboardColumnPerformance}" CellTemplate="{StaticResource PerformanceTemplate}" Width="86" MinWidth="86"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid></Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Background="{StaticResource DashboardEnemySurface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"><Grid Margin="10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Foreground="{StaticResource DashboardRed}" FontSize="14.5" FontWeight="Bold" VerticalAlignment="Center"><Run Text="{DynamicResource LabelEnemies}"/><Run Text=" ("/><Run Text="{Binding EnemyTotalCount, Mode=OneWay}"/><Run Text=")"/></TextBlock><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="EnemyAll" Tag="Enemy:All" Style="{StaticResource FilterButtonActive}" Click="Filter_Click"/><Button x:Name="EnemyMarked" Tag="Enemy:Marked" Style="{StaticResource FilterButton}" Click="Filter_Click"/><Button x:Name="EnemyLow" Tag="Enemy:LowSample" Style="{StaticResource FilterButton}" Click="Filter_Click"/><Button x:Name="EnemyAnomaly" Tag="Enemy:Anomaly" Style="{StaticResource FilterButton}" Click="Filter_Click"/></StackPanel></Grid></Border>
                        <DataGrid x:Name="EnemiesGrid" Grid.Row="1" Style="{StaticResource RosterGrid}" RowStyle="{StaticResource RosterRowStyle}" ItemsSource="{Binding Enemies}" LoadingRow="RosterGrid_LoadingRow">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{DynamicResource DashboardColumnPlayer}" CellTemplate="{StaticResource PlayerTemplate}" Width="*" MinWidth="210"/>
                                <DataGridTemplateColumn x:Name="EnemyContextColumn" Header="{DynamicResource DashboardContextAccount}" HeaderTemplate="{StaticResource ContextHeaderTemplate}" CellTemplate="{StaticResource ContextTemplate}" Width="90" MinWidth="90"/>
                                <DataGridTemplateColumn x:Name="EnemyShipColumn" Header="{DynamicResource DashboardColumnCurrentShip}" HeaderTemplate="{StaticResource ShipHeaderTemplate}" CellTemplate="{StaticResource ShipTemplate}" Width="112" MinWidth="112"/>
                                <DataGridTemplateColumn x:Name="EnemyPrColumn" Header="PR" CellTemplate="{StaticResource PrTemplate}" Width="94" MinWidth="94" Visibility="{Binding Source={x:Static p:Settings.Default}, Path=PRVisibility, Converter={StaticResource ColumnVisibility}}"/>
                                <DataGridTemplateColumn x:Name="EnemyPerformanceColumn" Header="{DynamicResource DashboardColumnPerformance}" CellTemplate="{StaticResource PerformanceTemplate}" Width="86" MinWidth="86"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid></Border>
                </Grid>

            </Grid>

            <Border x:Name="AnalysisDrawer" Grid.RowSpan="2" Width="420" HorizontalAlignment="Right" Background="White" BorderBrush="#CFD9E6" BorderThickness="1,0,0,0" Panel.ZIndex="30" Visibility="Collapsed" Padding="10">
                <Border.Effect><DropShadowEffect Color="#29415F" BlurRadius="18" ShadowDepth="-3" Opacity="0.22"/></Border.Effect>
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="3*"/><RowDefinition Height="1*"/><RowDefinition Height="92"/></Grid.RowDefinitions>
                    <StackPanel><DockPanel Margin="4,0,0,6"><Button DockPanel.Dock="Right" Content="×" Width="30" Height="30" Click="ToggleAnalysis_Click"/><TextBlock Text="{DynamicResource AnalysisPanelTitle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                        <TextBlock Text="{Binding Summary.Carrier.AllySummaryText}" Foreground="{StaticResource DashboardBlue}" FontSize="12" TextWrapping="Wrap" Visibility="{Binding Summary.Carrier.IsVisible, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{Binding Summary.Carrier.EnemySummaryText}" Foreground="{StaticResource DashboardRed}" FontSize="12" TextWrapping="Wrap" Visibility="{Binding Summary.Carrier.IsVisible, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{Binding Summary.Destroyer.AllySummaryText}" Foreground="{StaticResource DashboardBlue}" FontSize="12" TextWrapping="Wrap" Visibility="{Binding Summary.Destroyer.IsVisible, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{Binding Summary.Destroyer.EnemySummaryText}" Foreground="{StaticResource DashboardRed}" FontSize="12" TextWrapping="Wrap" Visibility="{Binding Summary.Destroyer.IsVisible, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                    <lvc:CartesianChart Grid.Row="1" x:Name="DashboardWinrateChart" TooltipTextSize="13" TooltipFindingStrategy="CompareAllTakeClosest" Margin="0,-8,0,-8"/>
                    <lvc:CartesianChart Grid.Row="2" x:Name="DashboardKdeChart" Margin="0,2,0,0"/>
                    <TextBox Grid.Row="3" x:Name="DashboardOutputText" Margin="0,6,0,0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>
                </Grid>
            </Border>
        </Grid>

        <Popup x:Name="NotificationPopup" PlacementTarget="{Binding ElementName=StatusButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Width="560" Height="170" Style="{StaticResource Card}" Padding="6" Margin="0,5,0,0" PreviewKeyDown="Root_PreviewKeyDown"><DataGrid HeadersVisibility="Column" RowHeight="27" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" ItemsSource="{Binding Source={x:Static utils:NotificationMessageUtils.NotificationMessageCollection}}"><DataGrid.Columns><DataGridTextColumn Header="{DynamicResource DataGridHeaderTime}" Binding="{Binding Time, StringFormat='{}{0:HH:mm:ss}'}" Width="78"/><DataGridTextColumn Header="{DynamicResource DataGridHeaderMessage}" Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid></Border>
        </Popup>
        <Popup x:Name="PlayerDetailPopup" Placement="Custom" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade" MouseEnter="PlayerDetailPopup_MouseEnter" MouseLeave="PlayerDetailPopup_MouseLeave">
            <Border x:Name="PlayerDetailBorder" Width="560" MaxHeight="720" Style="{StaticResource Card}" Padding="10" Margin="6"><ScrollViewer VerticalScrollBarVisibility="Auto"><controls:PlayerDetailCard x:Name="PlayerDetailCardContent"/></ScrollViewer></Border>
        </Popup>
    </Grid>
</UserControl>
