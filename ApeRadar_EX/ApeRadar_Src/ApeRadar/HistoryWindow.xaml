<Window x:Class="ApeRadar.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:cvt="clr-namespace:ApeRadar.Utils.Converters"
        xmlns:utils="clr-namespace:ApeRadar.Utils"
        Title="{DynamicResource HistoryWindowTitle}" Width="1180" Height="760" MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <cvt:BattleResultColorConverter x:Key="CvtBattleResultColor"/>
        <cvt:BattleResultBackgroundColorConverter x:Key="CvtBattleResultBackgroundColor"/>
        <cvt:HistoryPrColorConverter x:Key="CvtHistoryPrColor"/>
        <cvt:HistoryPrBackgroundColorConverter x:Key="CvtHistoryPrBackgroundColor"/>
        <utils:ShipTypeIconConverter x:Key="CvtShipTypeIcon"/>
        <utils:ShipTypeIconVisibilityConverter x:Key="CvtShipTypeIconVisibility"/>
        <utils:ShipTypeDisplayNameConverter x:Key="CvtShipTypeDisplayName"/>
        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="BorderBrush" Value="#D6DCE5"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="#FAFBFD"/>
        </Style>
        <DataTemplate x:Key="HistoryResultCellTemplate">
            <Border Background="{Binding ResultValue, Converter={StaticResource CvtBattleResultBackgroundColor}}" CornerRadius="3" Padding="5,2" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Result}" Foreground="{Binding ResultValue, Converter={StaticResource CvtBattleResultColor}}" FontWeight="SemiBold"/>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="HistoryDamageCellTemplate">
            <Border Background="{Binding DamageRatingValue, Converter={StaticResource CvtHistoryPrBackgroundColor}}" CornerRadius="3" Padding="5,2" HorizontalAlignment="Right">
                <TextBlock Text="{Binding Damage}" Foreground="{Binding DamageRatingValue, Converter={StaticResource CvtHistoryPrColor}}" TextAlignment="Right" FontWeight="SemiBold"/>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="HistoryFragsCellTemplate">
            <Border Background="{Binding FragsRatingValue, Converter={StaticResource CvtHistoryPrBackgroundColor}}" CornerRadius="3" Padding="5,2" HorizontalAlignment="Right">
                <TextBlock Text="{Binding Frags}" Foreground="{Binding FragsRatingValue, Converter={StaticResource CvtHistoryPrColor}}" TextAlignment="Right" FontWeight="SemiBold"/>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="HistoryPrCellTemplate">
            <Border Background="{Binding PrValue, Converter={StaticResource CvtHistoryPrBackgroundColor}}" CornerRadius="3" Padding="5,2" HorizontalAlignment="Right">
                <TextBlock Text="{Binding Pr}" Foreground="{Binding PrValue, Converter={StaticResource CvtHistoryPrColor}}" TextAlignment="Right" FontWeight="SemiBold"/>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="HistoryShipNameCellTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding ShipName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Image Source="{Binding ShipType, Converter={StaticResource CvtShipTypeIcon}}" Visibility="{Binding ShipType, Converter={StaticResource CvtShipTypeIconVisibility}}" Width="18" Height="18" Margin="4,0,0,0" ToolTip="{Binding ShipType, Converter={StaticResource CvtShipTypeDisplayName}}"/></StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="HistoryPlayerShipCellTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding Ship}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Image Source="{Binding ShipType, Converter={StaticResource CvtShipTypeIcon}}" Visibility="{Binding ShipType, Converter={StaticResource CvtShipTypeIconVisibility}}" Width="18" Height="18" Margin="4,0,0,0" ToolTip="{Binding ShipType, Converter={StaticResource CvtShipTypeDisplayName}}"/></StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="HistoryShipFilterTemplate">
            <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Display}" VerticalAlignment="Center"/><Image Source="{Binding ShipType, Converter={StaticResource CvtShipTypeIcon}}" Visibility="{Binding ShipType, Converter={StaticResource CvtShipTypeIconVisibility}}" Width="18" Height="18" Margin="4,0,0,0" ToolTip="{Binding ShipType, Converter={StaticResource CvtShipTypeDisplayName}}"/></StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <WrapPanel x:Name="HistoryFilters" Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Margin="0,0,12,6"><TextBlock Text="{DynamicResource HistoryServer}"/><ComboBox Width="125" ItemsSource="{Binding Servers}" DisplayMemberPath="Display" SelectedItem="{Binding SelectedServer}" SelectionChanged="Server_SelectionChanged"/></StackPanel>
            <StackPanel Margin="0,0,12,6"><TextBlock Text="{DynamicResource HistoryAccount}"/><ComboBox Width="175" ItemsSource="{Binding Accounts}" DisplayMemberPath="Display" SelectedItem="{Binding SelectedAccount}" SelectionChanged="Account_SelectionChanged"/></StackPanel>
            <StackPanel Margin="0,0,12,6"><TextBlock Text="{DynamicResource HistoryShip}"/><ComboBox Width="175" ItemsSource="{Binding Ships}" ItemTemplate="{StaticResource HistoryShipFilterTemplate}" SelectedItem="{Binding SelectedShip}" SelectionChanged="Filter_SelectionChanged"/></StackPanel>
            <StackPanel Margin="0,0,12,6"><TextBlock Text="{DynamicResource HistoryFromDate}"/><DatePicker Width="130" SelectedDate="{Binding FromDate}" SelectedDateChanged="Date_Changed"/></StackPanel>
            <StackPanel Margin="0,0,12,6"><TextBlock Text="{DynamicResource HistoryToDate}"/><DatePicker Width="130" SelectedDate="{Binding ToDate}" SelectedDateChanged="Date_Changed"/></StackPanel>
        </WrapPanel>

        <TabControl x:Name="HistoryTabs" Grid.Row="1">
            <TabItem Header="{DynamicResource HistoryTabCurrentSession}">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="{Binding CurrentSessionTitle}" FontSize="18" FontWeight="SemiBold" Margin="4,2,4,6"/>
                    <Border Grid.Row="1" Background="#EEF5FC" BorderBrush="#C8D9EC" BorderThickness="1" CornerRadius="5" Padding="9,6" Margin="4,0,4,6">
                        <StackPanel><TextBlock Text="{Binding CurrentSessionSampleText}" FontWeight="SemiBold"/><TextBlock Text="{Binding CurrentSessionSampleHint}" Foreground="#4D5E70" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel>
                    </Border>
                    <UniformGrid x:Name="CurrentSessionCards" Grid.Row="2" Columns="4" Margin="0,0,0,4">
                        <Border Style="{StaticResource SummaryCard}"><StackPanel><TextBlock Text="{DynamicResource HistoryRecordedBattles}"/><TextBlock Text="{Binding CurrentSessionBattlesText}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Style="{StaticResource SummaryCard}"><StackPanel><TextBlock Text="{Binding CurrentSessionResultLabel}"/><TextBlock Text="{Binding CurrentSessionWinrateText}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></Border>
                        <Border Style="{StaticResource SummaryCard}"><StackPanel><TextBlock Text="{DynamicResource HistoryAverageDamage}"/><TextBlock Text="{Binding CurrentSessionDamageText}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Style="{StaticResource SummaryCard}"><StackPanel><TextBlock Text="{DynamicResource HistoryAveragePr}"/><TextBlock Text="{Binding CurrentSessionPrText}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                    </UniformGrid>
                    <UniformGrid Grid.Row="3" Columns="3" Margin="0,0,0,4">
                        <Border Style="{StaticResource SummaryCard}"><StackPanel><TextBlock Text="{DynamicResource HistoryMetricSurvival}"/><TextBlock Text="{Binding CurrentSessionSurvivalText}" FontSize="15" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Style="{StaticResource SummaryCard}"><StackPanel><TextBlock Text="{DynamicResource HistoryMetricPotentialDamage}"/><TextBlock Text="{Binding CurrentSessionPotentialText}" FontSize="15" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Style="{StaticResource SummaryCard}"><StackPanel><TextBlock Text="{DynamicResource HistoryPendingBattles}"/><TextBlock Text="{Binding CurrentSessionPendingText}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                    </UniformGrid>
                    <ScrollViewer Grid.Row="4" MaxHeight="105" VerticalScrollBarVisibility="Auto" Margin="4,0,4,6"><ItemsControl ItemsSource="{Binding Insights}">
                        <ItemsControl.ItemTemplate><DataTemplate><Border Background="#F2F6FB" BorderBrush="#D8E1EC" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,2"><TextBlock Text="{Binding Text}" TextWrapping="Wrap"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl></ScrollViewer>
                    <DataGrid Grid.Row="5" ItemsSource="{Binding SessionBattles}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" MinHeight="120">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource HistoryColumnTime}" Binding="{Binding StartedAt}" Width="135"/><DataGridTemplateColumn Header="{DynamicResource HistoryColumnShip}" CellTemplate="{StaticResource HistoryShipNameCellTemplate}" Width="*"/>
                            <DataGridTemplateColumn Header="{DynamicResource HistoryColumnResult}" CellTemplate="{StaticResource HistoryResultCellTemplate}" Width="75"/><DataGridTemplateColumn Header="{DynamicResource HistoryColumnDamage}" CellTemplate="{StaticResource HistoryDamageCellTemplate}" Width="90"/>
                            <DataGridTemplateColumn Header="PR" CellTemplate="{StaticResource HistoryPrCellTemplate}" Width="70"/><DataGridTextColumn Header="{DynamicResource HistoryMetricSurvival}" Binding="{Binding Survival}" Width="85"/>
                            <DataGridTextColumn Header="{DynamicResource HistoryMetricPotentialDamage}" Binding="{Binding PotentialDamage}" Width="110"/><DataGridTextColumn Header="{DynamicResource HistoryColumnCompleteness}" Binding="{Binding Completeness}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource HistoryTabShipTrends}">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <WrapPanel Margin="4,0,0,4">
                        <StackPanel Margin="0,0,14,4"><TextBlock Text="{DynamicResource HistoryMetric}"/><ComboBox Width="180" ItemsSource="{Binding MetricOptions}" DisplayMemberPath="Display" SelectedItem="{Binding SelectedMetric}" SelectionChanged="Filter_SelectionChanged"/></StackPanel>
                        <StackPanel Margin="0,0,14,4"><TextBlock Text="{DynamicResource HistoryRollingWindow}"/><ComboBox Width="100" ItemsSource="{Binding RollingWindowOptions}" DisplayMemberPath="Display" SelectedItem="{Binding SelectedRollingWindow}" SelectionChanged="Filter_SelectionChanged"/></StackPanel>
                    </WrapPanel>
                    <TextBlock Grid.Row="1" Text="{Binding ChartGuidanceText}" TextWrapping="Wrap" Padding="8,4" Margin="4,0,4,4">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#9A5B00"/><Setter Property="Background" Value="#FFF8E8"/><Style.Triggers><DataTrigger Binding="{Binding ChartGuidanceText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <UniformGrid x:Name="TrendSummaryCards" Grid.Row="2" Columns="3" Margin="0,0,0,6">
                        <Border Style="{StaticResource SummaryCard}"><StackPanel><TextBlock Text="{DynamicResource HistoryRecordedBattles}"/><TextBlock Text="{Binding RecordedBattlesText}" FontSize="21" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Style="{StaticResource SummaryCard}"><StackPanel><TextBlock Text="{DynamicResource HistoryWinrate}"/><TextBlock Text="{Binding WinrateText}" FontSize="21" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Style="{StaticResource SummaryCard}"><StackPanel><TextBlock Text="{DynamicResource HistoryAverageDamage}"/><Border Background="{Binding AverageDamageRatingValue, Converter={StaticResource CvtHistoryPrBackgroundColor}}" CornerRadius="4" Padding="5,1" HorizontalAlignment="Left"><TextBlock Text="{Binding AverageDamageText}" Foreground="{Binding AverageDamageRatingValue, Converter={StaticResource CvtHistoryPrColor}}" FontSize="21" FontWeight="SemiBold"/></Border></StackPanel></Border>
                        <Border Style="{StaticResource SummaryCard}"><StackPanel><TextBlock Text="{DynamicResource HistoryAverageFrags}"/><Border Background="{Binding AverageFragsRatingValue, Converter={StaticResource CvtHistoryPrBackgroundColor}}" CornerRadius="4" Padding="5,1" HorizontalAlignment="Left"><TextBlock Text="{Binding AverageFragsText}" Foreground="{Binding AverageFragsRatingValue, Converter={StaticResource CvtHistoryPrColor}}" FontSize="21" FontWeight="SemiBold"/></Border></StackPanel></Border>
                        <Border Style="{StaticResource SummaryCard}"><StackPanel><TextBlock Text="{DynamicResource HistoryAveragePr}"/><TextBlock Text="{Binding AveragePrText}" Foreground="{Binding AveragePrValue, Converter={StaticResource CvtHistoryPrColor}}" FontSize="21" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Style="{StaticResource SummaryCard}"><StackPanel><TextBlock Text="{DynamicResource HistoryCompleteness}"/><TextBlock Text="{Binding CompletenessText}" FontSize="21" FontWeight="SemiBold"/></StackPanel></Border>
                    </UniformGrid>
                    <lvc:CartesianChart Grid.Row="3" x:Name="HistoryChart" Series="{Binding ChartSeries}" XAxes="{Binding ChartXAxes}" YAxes="{Binding ChartYAxes}" LegendPosition="Hidden" MinHeight="180"/>
                    <TextBlock Grid.Row="4" HorizontalAlignment="Right" Foreground="Gray" Margin="0,3"><Run Text="{DynamicResource HistoryPrDataVersion}"/><Run Text=" "/><Run Text="{Binding PrDataVersionText, Mode=OneWay}"/></TextBlock>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource HistoryTabBattles}">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="3*" MinHeight="190"/><RowDefinition Height="Auto"/><RowDefinition Height="2*" MinHeight="180"/></Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedBattle}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource HistoryColumnTime}" Binding="{Binding StartedAt}" Width="130"/><DataGridTextColumn Header="{DynamicResource HistoryColumnMap}" Binding="{Binding MapName}" Width="*"/>
                            <DataGridTemplateColumn Header="{DynamicResource HistoryColumnShip}" CellTemplate="{StaticResource HistoryShipNameCellTemplate}" Width="*"/>
                            <DataGridTemplateColumn Header="{DynamicResource HistoryColumnResult}" CellTemplate="{StaticResource HistoryResultCellTemplate}" Width="75"/>
                            <DataGridTemplateColumn Header="{DynamicResource HistoryColumnDamage}" CellTemplate="{StaticResource HistoryDamageCellTemplate}" Width="85"/>
                            <DataGridTemplateColumn Header="{DynamicResource HistoryColumnFrags}" CellTemplate="{StaticResource HistoryFragsCellTemplate}" Width="65"/>
                            <DataGridTemplateColumn Header="PR" CellTemplate="{StaticResource HistoryPrCellTemplate}" Width="65"/>
                            <DataGridTextColumn Header="{DynamicResource HistoryColumnCompleteness}" Binding="{Binding Completeness}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5">
                        <Button Content="{DynamicResource HistoryPreviousPage}" MinWidth="78" IsEnabled="{Binding CanGoPrevious}" Click="PreviousPage_Click"/>
                        <TextBlock Text="{Binding PageText}" MinWidth="70" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <Button Content="{DynamicResource HistoryNextPage}" MinWidth="78" IsEnabled="{Binding CanGoNext}" Click="NextPage_Click"/>
                    </StackPanel>
                    <Border Grid.Row="2" BorderBrush="#D6DCE5" BorderThickness="1" CornerRadius="6" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Text="{Binding BattleDetailTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text=" · " FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding BattleDetailShipName}" FontSize="16" FontWeight="SemiBold"/><Image Source="{Binding BattleDetailShipType, Converter={StaticResource CvtShipTypeIcon}}" Visibility="{Binding BattleDetailShipType, Converter={StaticResource CvtShipTypeIconVisibility}}" Width="18" Height="18" Margin="4,0,0,0" ToolTip="{Binding BattleDetailShipType, Converter={StaticResource CvtShipTypeDisplayName}}"/></StackPanel><TextBlock Text="{Binding BattleDetailMetrics}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="{DynamicResource HistoryExperimentalWarning}" Foreground="#9A5B00" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="{DynamicResource HistoryDamageBreakdown}" FontWeight="SemiBold"/>
                            <DataGrid ItemsSource="{Binding DamageBreakdowns}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="120" Margin="0,3,0,8"><DataGrid.Columns><DataGridTextColumn Header="{DynamicResource HistoryDirection}" Binding="{Binding Direction}" Width="80"/><DataGridTextColumn Header="{DynamicResource HistoryDamageType}" Binding="{Binding Type}" Width="*"/><DataGridTextColumn Header="{DynamicResource HistoryColumnDamage}" Binding="{Binding Damage}" Width="85"/><DataGridTextColumn Header="{DynamicResource HistoryColumnCompleteness}" Binding="{Binding Quality}" Width="85"/></DataGrid.Columns></DataGrid>
                            <TextBlock Text="{DynamicResource HistoryRosterSnapshot}" FontWeight="SemiBold"/>
                            <DataGrid ItemsSource="{Binding BattlePlayers}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="150" Margin="0,3,0,8"><DataGrid.Columns><DataGridTextColumn Header="{DynamicResource HistoryRelation}" Binding="{Binding Relation}" Width="65"/><DataGridTextColumn Header="{DynamicResource HistoryPlayer}" Binding="{Binding Player}" Width="*"/><DataGridTemplateColumn Header="{DynamicResource HistoryColumnShip}" CellTemplate="{StaticResource HistoryPlayerShipCellTemplate}" Width="*"/><DataGridTextColumn Header="{DynamicResource HistoryWinrate}" Binding="{Binding Winrate}" Width="75"/><DataGridTextColumn Header="PR" Binding="{Binding Pr}" Width="65"/></DataGrid.Columns></DataGrid>
                            <CheckBox Content="{DynamicResource HistoryFavorite}" IsChecked="{Binding IsFavorite}" Margin="0,0,0,5"/>
                            <ItemsControl ItemsSource="{Binding ReviewTags}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Display}" IsChecked="{Binding IsSelected}" Margin="0,2,10,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <TextBox Text="{Binding ReviewNote, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="75" MaxLength="4000" VerticalScrollBarVisibility="Auto" Margin="0,6"/>
                            <Button Content="{DynamicResource HistorySaveReview}" HorizontalAlignment="Left" MinWidth="100" Height="30" Click="SaveReview_Click"/>
                        </StackPanel></ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource HistoryTabSessions}">
                <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="150"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*" MinHeight="150"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid x:Name="SessionGrid" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" SelectionMode="Extended" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="{DynamicResource HistoryColumnTime}" Binding="{Binding StartedAt}" Width="135"/><DataGridTextColumn Header="{DynamicResource HistorySessionEnd}" Binding="{Binding EndedAt}" Width="70"/><DataGridTextColumn Header="{DynamicResource HistoryAccount}" Binding="{Binding Account}" Width="*"/><DataGridTextColumn Header="{DynamicResource HistoryServer}" Binding="{Binding Server}" Width="90"/><DataGridTextColumn Header="{DynamicResource HistoryRecordedBattles}" Binding="{Binding Battles}" Width="80"/><DataGridTextColumn Header="{DynamicResource HistorySessionType}" Binding="{Binding Type}" Width="95"/></DataGrid.Columns></DataGrid>
                    <Button Grid.Row="1" Content="{DynamicResource HistoryMergeSessions}" MinWidth="110" Height="30" HorizontalAlignment="Left" Margin="0,5,0,0" Click="MergeSessions_Click"/>
                    <DataGrid Grid.Row="3" ItemsSource="{Binding SessionBattles}" SelectedItem="{Binding SelectedSessionBattle}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="{DynamicResource HistoryColumnTime}" Binding="{Binding StartedAt}" Width="135"/><DataGridTemplateColumn Header="{DynamicResource HistoryColumnShip}" CellTemplate="{StaticResource HistoryShipNameCellTemplate}" Width="*"/><DataGridTemplateColumn Header="{DynamicResource HistoryColumnResult}" CellTemplate="{StaticResource HistoryResultCellTemplate}" Width="80"/><DataGridTemplateColumn Header="{DynamicResource HistoryColumnDamage}" CellTemplate="{StaticResource HistoryDamageCellTemplate}" Width="95"/><DataGridTemplateColumn Header="PR" CellTemplate="{StaticResource HistoryPrCellTemplate}" Width="75"/></DataGrid.Columns></DataGrid>
                    <Button Grid.Row="4" Content="{DynamicResource HistorySplitBeforeBattle}" MinWidth="140" Height="30" HorizontalAlignment="Left" Margin="0,5,0,0" Click="SplitSession_Click"/>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="HistoryStatusText" Grid.Row="2" Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="4,6,4,2"/>
        <WrapPanel x:Name="HistoryFooterButtons" Grid.Row="3" HorizontalAlignment="Right">
                <Button Content="{DynamicResource HistoryRefresh}" MinWidth="80" Height="32" Margin="3" Click="Refresh_Click"/><Button Content="{DynamicResource HistoryRetryReplay}" MinWidth="105" Height="32" Margin="3" Click="RetryReplay_Click"/>
                <Button Content="{DynamicResource HistoryCancelImport}" MinWidth="95" Height="32" Margin="3" Click="CancelImport_Click"/><Button Content="{DynamicResource HistoryRetryApi}" MinWidth="90" Height="32" Margin="3" Click="RetryApi_Click"/>
                <Button Content="{DynamicResource HistoryOpenData}" MinWidth="95" Height="32" Margin="3" Click="OpenData_Click"/><Button Content="{DynamicResource HistoryClear}" MinWidth="80" Height="32" Margin="3" Click="Clear_Click"/>
        </WrapPanel>
    </Grid>
</Window>
