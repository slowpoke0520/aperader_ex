<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF" xmlns:cvt="clr-namespace:ApeRadar.Utils.Converters" x:Class="ApeRadar.HistoryWindow" Title="{DynamicResource HistoryWindowTitle}" Width="1180" Height="800" MinWidth="860" MinHeight="620" Background="{StaticResource SurfaceBrush}" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <cvt:BattleResultColorConverter x:Key="ResultColor"/>
        <cvt:BattleResultBackgroundColorConverter x:Key="ResultBackground"/>
        <cvt:HistoryPrColorConverter x:Key="PrColor"/>
        <CollectionViewSource x:Key="RecordsView" Source="{Binding Rows}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="DateGroup"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <Style x:Key="Table" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="ColumnHeaderHeight" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="EnableColumnVirtualization" Value="False"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="True"/>
            <EventSetter Event="Loaded" Handler="HistoryTable_Loaded"/>
            <EventSetter Event="SizeChanged" Handler="HistoryTable_SizeChanged"/>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="9,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style x:Key="NumberCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style x:Key="NumberHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="9,5"/>
        </Style>
        <Style x:Key="Notice" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Empty" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="30"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="MetricCell" TargetType="Border">
            <Setter Property="Padding" Value="20,13"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>
        <Style x:Key="PlainButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="HistoryTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Line" Padding="2,10,2,9" Margin="0,0,24,0" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter x:Name="TabLabel" ContentSource="Header" VerticalAlignment="Center" TextElement.Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabLabel" Property="TextElement.Foreground" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="TabLabel" Property="TextElement.FontWeight" Value="SemiBold"/>
                                <Setter TargetName="Line" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabLabel" Property="TextElement.Foreground" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ResultCell">
            <Border Background="{Binding ResultValue, Converter={StaticResource ResultBackground}}" CornerRadius="3" Padding="7,3" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Result}" Foreground="{Binding ResultValue, Converter={StaticResource ResultColor}}"/>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="DamageCell">
            <TextBlock Text="{Binding Damage}" Style="{StaticResource NumberCell}"/>
        </DataTemplate>
        <DataTemplate x:Key="PrCell">
            <TextBlock Text="{Binding Pr}" Foreground="{Binding PrValue, Converter={StaticResource PrColor}}" FontWeight="SemiBold" Style="{StaticResource NumberCell}"/>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="24,16,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <WrapPanel x:Name="HistoryFooterButtons" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <ComboBox Width="95" ToolTip="{DynamicResource HistoryServer}" ItemsSource="{Binding Servers}" DisplayMemberPath="Display" SelectedItem="{Binding SelectedServer}" SelectionChanged="Server_SelectionChanged" Margin="0,0,7,0"/>
                <ComboBox Width="170" ToolTip="{DynamicResource HistoryAccount}" ItemsSource="{Binding Accounts}" DisplayMemberPath="Display" SelectedItem="{Binding SelectedAccount}" SelectionChanged="Account_SelectionChanged" Margin="0,0,10,0"/>
                <Button Content="{DynamicResource HistoryRefresh}" Click="Refresh_Click" Height="32" Margin="0,0,6,0"/>
                <Button Content="{DynamicResource HistoryMore}" Click="More_Click" Height="32" Margin="0">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{DynamicResource HistoryResetFilters}" Click="ResetFilters_Click"/>
                            <MenuItem Header="{DynamicResource HistoryRecordManagement}" Click="ShowManagement_Click"/>
                            <Separator/>
                            <MenuItem Header="{DynamicResource HistoryRetryReplay}" Click="RetryReplay_Click"/>
                            <MenuItem Header="{DynamicResource HistoryRetryApi}" Click="RetryApi_Click"/>
                            <MenuItem Header="{DynamicResource HistoryCancelImport}" Click="CancelImport_Click"/>
                            <Separator/>
                            <MenuItem Header="{DynamicResource HistoryOpenData}" Click="OpenData_Click"/>
                            <MenuItem Header="{DynamicResource HistoryClear}" Click="Clear_Click" Foreground="{StaticResource ErrorBrush}"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </WrapPanel>
            <TextBlock Text="{DynamicResource HistoryWindowTitle}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid x:Name="HistoryOverview">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBattleDetailOpen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <WrapPanel x:Name="HistoryFilters" Margin="0,0,0,12">
                    <ComboBox Width="115" ItemsSource="{Binding DateRanges}" DisplayMemberPath="Display" SelectedItem="{Binding SelectedDateRange}" SelectionChanged="Range_SelectionChanged" Margin="0,0,10,0"/>
                    <ComboBox Width="175" ToolTip="{DynamicResource HistoryShip}" ItemsSource="{Binding Ships}" DisplayMemberPath="Display" SelectedItem="{Binding SelectedShip}" SelectionChanged="Filter_SelectionChanged" Margin="0,0,16,0"/>
                    <CheckBox Content="{DynamicResource HistoryOnlyFavorites}" IsChecked="{Binding FavoritesOnly}" Click="FavoritesFilter_Click" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <WrapPanel>
                        <WrapPanel.Style>
                            <Style TargetType="WrapPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedDateRange.Value}" Value="custom">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </WrapPanel.Style>
                        <DatePicker Width="125" Height="32" ToolTip="{DynamicResource HistoryFromDate}" SelectedDate="{Binding FromDate}" SelectedDateChanged="Date_Changed"/>
                        <TextBlock Text="–" Margin="6,0" VerticalAlignment="Center"/>
                        <DatePicker Width="125" Height="32" ToolTip="{DynamicResource HistoryToDate}" SelectedDate="{Binding ToDate}" SelectedDateChanged="Date_Changed"/>
                    </WrapPanel>
                </WrapPanel>
                <Grid Grid.Row="1">
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Background="{StaticResource SurfaceMutedBrush}" Margin="0,0,0,12">
                        <UniformGrid Columns="4" x:Name="TrendSummaryCards">
                            <Border Style="{StaticResource MetricCell}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource HistoryRecordedBattles}" Style="{StaticResource MetricLabel}"/>
                                    <TextBlock Text="{Binding RecordedBattlesText}" Style="{StaticResource MetricValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCell}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource HistoryWinrate}" Style="{StaticResource MetricLabel}"/>
                                    <TextBlock Text="{Binding WinrateText}" Style="{StaticResource MetricValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCell}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource HistoryAverageDamage}" Style="{StaticResource MetricLabel}"/>
                                    <TextBlock Text="{Binding AverageDamageText}" Style="{StaticResource MetricValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCell}" BorderThickness="0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource HistoryAggregatePr}" Style="{StaticResource MetricLabel}"/>
                                    <TextBlock ToolTip="{Binding PrSampleText}" Text="{Binding AveragePrText}" Style="{StaticResource MetricValue}" Foreground="{Binding AveragePrValue, Converter={StaticResource PrColor}}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Border>
                </Grid>
                <TabControl x:Name="HistoryTabs" Grid.Row="2" SelectedIndex="0" BorderThickness="0" Padding="0" Background="Transparent" SelectionChanged="HistoryTabs_SelectionChanged">
                    <TabControl.Resources>
                        <Style TargetType="TabItem" BasedOn="{StaticResource HistoryTab}"/>
                    </TabControl.Resources>
                    <TabItem Header="{DynamicResource HistoryTabBattles}">
                        <Grid x:Name="RecordsLayout" Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding DataNotice}" Style="{StaticResource Notice}"/>
                            <Button Grid.Row="1" HorizontalAlignment="Left" Click="ShowManagement_Click" Margin="0,0,0,6">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PlainButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IntervalNotice}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="{Binding IntervalNotice}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}"/>
                            </Button>
                            <Grid Grid.Row="2">
                                <DataGrid x:Name="RecordsGrid" Style="{StaticResource Table}" ItemsSource="{Binding Source={StaticResource RecordsView}}" SelectedItem="{Binding SelectedBattle, Mode=TwoWay}" PreviewMouseLeftButtonDown="RecordsGrid_MouseDown">
                                    <DataGrid.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource SurfaceMutedBrush}" Padding="9,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding ItemCount, StringFormat=' · {0}'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </DataGrid.GroupStyle>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Width="37" CanUserSort="False" MinWidth="37">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding FavoriteSymbol}" ToolTip="{DynamicResource HistoryFavorite}" Style="{StaticResource PlainButton}" Click="RowFavorite_Click" Foreground="{StaticResource WarningBrush}" FontSize="17"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="{DynamicResource HistoryColumnTime}" Binding="{Binding Time}" ElementStyle="{StaticResource Cell}" Width="68" SortMemberPath="Battle.StartedAt" MinWidth="68"/>
                                        <DataGridTextColumn Header="{DynamicResource HistoryColumnMap}" Binding="{Binding MapName}" ElementStyle="{StaticResource Cell}" Width="*" MinWidth="90"/>
                                        <DataGridTextColumn Header="{DynamicResource HistoryColumnShip}" Binding="{Binding ShipName}" ElementStyle="{StaticResource Cell}" Width="*" MinWidth="125"/>
                                        <DataGridTemplateColumn Header="{DynamicResource HistoryColumnResult}" CellTemplate="{StaticResource ResultCell}" Width="70" SortMemberPath="Battle.Result" MinWidth="70"/>
                                        <DataGridTemplateColumn Header="{DynamicResource HistoryColumnDamage}" CellTemplate="{StaticResource DamageCell}" Width="95" SortMemberPath="Battle.Damage" HeaderStyle="{StaticResource NumberHeader}" MinWidth="95"/>
                                        <DataGridTextColumn Header="{DynamicResource HistoryColumnFrags}" Binding="{Binding Frags}" ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}" Width="56" SortMemberPath="Battle.Frags" MinWidth="56"/>
                                        <DataGridTemplateColumn Header="PR" CellTemplate="{StaticResource PrCell}" Width="69" SortMemberPath="PrValue" HeaderStyle="{StaticResource NumberHeader}" MinWidth="69"/>
                                        <DataGridTextColumn Header="{DynamicResource HistoryReview}" Binding="{Binding NoteSymbol}" ElementStyle="{StaticResource Cell}" Width="54" CanUserSort="False" MinWidth="54"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="{DynamicResource HistoryNoRecordsInRange}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Empty}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <DockPanel Grid.Row="3" Margin="0,10,0,0">
                                <TextBlock Text="{DynamicResource HistoryOpenBattleHint}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="{DynamicResource HistoryPreviousPage}" Click="PreviousPage_Click" IsEnabled="{Binding CanGoPrevious}" Margin="0"/>
                                    <TextBlock Text="{Binding PageText}" MinWidth="70" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <Button Content="{DynamicResource HistoryNextPage}" Click="NextPage_Click" IsEnabled="{Binding CanGoNext}" Margin="0"/>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </TabItem>
                    <TabItem Header="{DynamicResource HistoryTabShipTrends}">
                        <Grid Margin="0,14,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <WrapPanel>
                                <ComboBox Width="180" ItemsSource="{Binding MetricOptions}" DisplayMemberPath="Display" SelectedItem="{Binding SelectedMetric}" SelectionChanged="Filter_SelectionChanged" Margin="0,0,10,0"/>
                                <ComboBox Width="125" ItemsSource="{Binding RollingWindowOptions}" DisplayMemberPath="Display" SelectedItem="{Binding SelectedRollingWindow}" SelectionChanged="Filter_SelectionChanged" Margin="0,0,12,0"/>
                                <TextBlock Text="{DynamicResource HistoryTrendCalculationHint}" Style="{StaticResource Notice}" VerticalAlignment="Center"/>
                            </WrapPanel>
                            <TextBlock Grid.Row="1" Text="{Binding ChartGuidanceText}" Style="{StaticResource Notice}"/>
                            <lvc:CartesianChart Grid.Row="2" x:Name="HistoryChart" Series="{Binding ChartSeries}" XAxes="{Binding ChartXAxes}" YAxes="{Binding ChartYAxes}" LegendPosition="Hidden" MinHeight="150"/>
                            <TextBlock Grid.Row="3" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Right">
                                <Run Text="{DynamicResource HistoryPrDataVersion}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding PrDataVersionText, Mode=OneWay}"/>
                            </TextBlock>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="ManagementTab" Header="{DynamicResource HistoryRecordManagement}" Visibility="Collapsed">
                        <TabControl Margin="0,10,0,0" BorderThickness="0" Padding="0">
                            <TabControl.Resources>
                                <Style TargetType="TabItem" BasedOn="{StaticResource HistoryTab}"/>
                            </TabControl.Resources>
                            <TabItem Header="{DynamicResource HistoryApiIntervals}">
                                <Grid Margin="0,10,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{DynamicResource HistoryApiIntervalsHint}" Style="{StaticResource Notice}"/>
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding ApiIntervals}" Style="{StaticResource Table}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{DynamicResource HistoryIntervalPeriod}" Binding="{Binding Period}" ElementStyle="{StaticResource Cell}" Width="220" MinWidth="220"/>
                                            <DataGridTextColumn Header="{DynamicResource HistoryColumnShip}" Binding="{Binding Ship}" ElementStyle="{StaticResource Cell}" Width="*"/>
                                            <DataGridTextColumn Header="{DynamicResource HistoryRecordedBattles}" Binding="{Binding Count}" ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}" Width="68" MinWidth="68"/>
                                            <DataGridTextColumn Header="{DynamicResource HistoryWins}" Binding="{Binding Wins}" ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}" Width="58" MinWidth="58"/>
                                            <DataGridTextColumn Header="{DynamicResource HistoryIntervalDamage}" Binding="{Binding Damage}" ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}" Width="108" MinWidth="108"/>
                                            <DataGridTextColumn Header="{DynamicResource HistoryColumnFrags}" Binding="{Binding Frags}" ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}" Width="60" MinWidth="60"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </TabItem>
                            <TabItem Header="{DynamicResource HistoryTabSessions}">
                                <Grid Margin="0,10,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <DataGrid x:Name="SessionGrid" Style="{StaticResource Table}" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" SelectionMode="Extended">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{DynamicResource HistoryColumnTime}" Binding="{Binding StartedAt}" ElementStyle="{StaticResource Cell}" Width="145" MinWidth="145"/>
                                            <DataGridTextColumn Header="{DynamicResource HistorySessionEnd}" Binding="{Binding EndedAt}" ElementStyle="{StaticResource Cell}" Width="75" MinWidth="75"/>
                                            <DataGridTextColumn Header="{DynamicResource HistoryAccount}" Binding="{Binding Account}" ElementStyle="{StaticResource Cell}" Width="*"/>
                                            <DataGridTextColumn Header="{DynamicResource HistoryServer}" Binding="{Binding Server}" ElementStyle="{StaticResource Cell}" Width="80" MinWidth="80"/>
                                            <DataGridTextColumn Header="{DynamicResource HistorySessionType}" Binding="{Binding Type}" ElementStyle="{StaticResource Cell}" Width="100" MinWidth="100"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Button Content="{DynamicResource HistoryMergeSessions}" Click="MergeSessions_Click" Grid.Row="1" HorizontalAlignment="Left" Margin="0,7,0,12"/>
                                    <DataGrid Grid.Row="2" Style="{StaticResource Table}" ItemsSource="{Binding SessionBattles}" SelectedItem="{Binding SelectedSessionBattle}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{DynamicResource HistoryColumnTime}" Binding="{Binding StartedAt}" ElementStyle="{StaticResource Cell}" Width="145" MinWidth="145"/>
                                            <DataGridTextColumn Header="{DynamicResource HistoryColumnShip}" Binding="{Binding ShipName}" ElementStyle="{StaticResource Cell}" Width="*"/>
                                            <DataGridTemplateColumn Header="{DynamicResource HistoryColumnResult}" CellTemplate="{StaticResource ResultCell}" Width="85" MinWidth="85"/>
                                            <DataGridTemplateColumn Header="{DynamicResource HistoryColumnDamage}" CellTemplate="{StaticResource DamageCell}" Width="100" MinWidth="100"/>
                                            <DataGridTemplateColumn Header="PR" CellTemplate="{StaticResource PrCell}" Width="75" MinWidth="75"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Button Content="{DynamicResource HistorySplitBeforeBattle}" Click="SplitSession_Click" Grid.Row="3" HorizontalAlignment="Left" Margin="0,7,0,0"/>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </TabItem>
                </TabControl>
            </Grid>
            <Grid x:Name="BattleDetailBody">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBattleDetailOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,4,0,8">
                    <Button Click="BackToRecords_Click" DockPanel.Dock="Left"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PlainButton}"><Setter Property="Content" Value="{DynamicResource HistoryBackToRecords}"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=HistoryTabs}" Value="1"><Setter Property="Content" Value="{DynamicResource HistoryBackToTrends}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource HistoryPreviousBattle}" Click="PreviousBattle_Click" IsEnabled="{Binding CanGoPreviousBattle}" Margin="0,0,8,0"/>
                        <Button Content="{DynamicResource HistoryNextBattle}" Click="NextBattle_Click" IsEnabled="{Binding CanGoNextBattle}" Margin="0"/>
                    </StackPanel>
                </DockPanel>
                <DockPanel Grid.Row="1" x:Name="BattleDetailOverview" Margin="0,0,0,10">
                    <Button x:Name="SourceInfoButton" DockPanel.Dock="Right" Content="{DynamicResource HistoryDataDetails}" FontSize="12" Style="{StaticResource PlainButton}" Click="More_Click">
                        <Button.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem IsHitTestVisible="False" Focusable="False">
                                    <MenuItem.Header><StackPanel MaxWidth="380"><TextBlock Text="{Binding DetailSource}" TextWrapping="Wrap"/><TextBlock Text="{Binding BattleDetailAdvancedSummary}" TextWrapping="Wrap"/></StackPanel></MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="DetailFavoriteButton" DockPanel.Dock="Right" ToolTip="{DynamicResource HistoryFavorite}" Click="DetailFavorite_Click" IsEnabled="{Binding CanEditBattleReview}" FontSize="20" Foreground="{StaticResource WarningBrush}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PlainButton}">
                                <Setter Property="Content" Value="☆"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                        <Setter Property="Content" Value="★"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding BattleDetailShipName}" FontSize="23" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedBattle.Result}" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{Binding SelectedBattle.ResultValue, Converter={StaticResource ResultColor}}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="{Binding BattleDetailTitle}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                </DockPanel>
                <Grid Grid.Row="2">
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Background="{StaticResource SurfaceMutedBrush}" Margin="0,0,0,12">
                        <UniformGrid Columns="4">
                            <Border Style="{StaticResource MetricCell}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource HistoryColumnDamage}" Style="{StaticResource MetricLabel}"/>
                                    <TextBlock Text="{Binding SelectedBattle.Damage}" Style="{StaticResource MetricValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCell}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource HistoryColumnFrags}" Style="{StaticResource MetricLabel}"/>
                                    <TextBlock Text="{Binding SelectedBattle.Frags}" Style="{StaticResource MetricValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCell}">
                                <StackPanel>
                                    <TextBlock Text="PR" Style="{StaticResource MetricLabel}"/>
                                    <TextBlock Text="{Binding SelectedBattle.Pr}" Style="{StaticResource MetricValue}" Foreground="{Binding SelectedBattle.PrValue, Converter={StaticResource PrColor}}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCell}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource HistorySurvivalState}" Style="{StaticResource MetricLabel}"/>
                                    <TextBlock Text="{Binding DetailSurvival}" Style="{StaticResource MetricValue}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Border>
                </Grid>
                <StackPanel Grid.Row="3">
                    <TextBlock Text="{Binding DetailAvailability}" Style="{StaticResource Notice}" Margin="0,0,0,2"/>
                </StackPanel>
                <TabControl Grid.Row="4" x:Name="BattleDetailTabs" BorderThickness="0" Padding="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem" BasedOn="{StaticResource HistoryTab}"/>
                    </TabControl.Resources>
                    <TabItem Header="{DynamicResource HistoryRosterSnapshot}">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource HistoryRosterStatsHint}" Style="{StaticResource Notice}"/>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{DynamicResource EncounterAlly}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Margin="9,0,0,8"/>
                                    <DataGrid Grid.Row="1" Style="{StaticResource Table}" ItemsSource="{Binding AllyPlayers}" RowHeight="32">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{DynamicResource HistoryPlayer}" Binding="{Binding Player}" ElementStyle="{StaticResource Cell}" Width="*" MinWidth="100"/>
                                            <DataGridTextColumn Header="{DynamicResource HistoryColumnShip}" Binding="{Binding Ship}" ElementStyle="{StaticResource Cell}" Width="*" MinWidth="75"/>
                                            <DataGridTextColumn Header="{DynamicResource HistoryWinrate}" Binding="{Binding Winrate}" ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}" Width="72" MinWidth="72"/>
                                            <DataGridTextColumn Header="PR" Binding="{Binding Pr}" HeaderStyle="{StaticResource NumberHeader}" Width="66" MinWidth="66">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}">
                                                        <Setter Property="Foreground" Value="{Binding PrValue, Converter={StaticResource PrColor}}"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{DynamicResource EncounterEnemy}" Foreground="{StaticResource ErrorBrush}" FontWeight="SemiBold" Margin="9,0,0,8"/>
                                    <DataGrid Grid.Row="1" Style="{StaticResource Table}" ItemsSource="{Binding EnemyPlayers}" RowHeight="32">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{DynamicResource HistoryPlayer}" Binding="{Binding Player}" ElementStyle="{StaticResource Cell}" Width="*" MinWidth="100"/>
                                            <DataGridTextColumn Header="{DynamicResource HistoryColumnShip}" Binding="{Binding Ship}" ElementStyle="{StaticResource Cell}" Width="*" MinWidth="75"/>
                                            <DataGridTextColumn Header="{DynamicResource HistoryWinrate}" Binding="{Binding Winrate}" ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}" Width="72" MinWidth="72"/>
                                            <DataGridTextColumn Header="PR" Binding="{Binding Pr}" HeaderStyle="{StaticResource NumberHeader}" Width="66" MinWidth="66">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}">
                                                        <Setter Property="Foreground" Value="{Binding PrValue, Converter={StaticResource PrColor}}"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                                <Grid Grid.ColumnSpan="3">
                                    <TextBlock Text="{DynamicResource HistoryNoRoster}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Empty}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BattlePlayers.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="{DynamicResource HistoryDamageBreakdown}">
                        <Grid Margin="0,14,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding BattleDetailAdvancedSummary}" Style="{StaticResource Notice}"/>
                            <Grid Grid.Row="1">
                                <DataGrid Style="{StaticResource Table}" ItemsSource="{Binding DamageBreakdowns}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{DynamicResource HistoryDirection}" Binding="{Binding Direction}" ElementStyle="{StaticResource Cell}" Width="100" MinWidth="100"/>
                                        <DataGridTextColumn Header="{DynamicResource HistoryDamageType}" Binding="{Binding Type}" ElementStyle="{StaticResource Cell}" Width="*"/>
                                        <DataGridTextColumn Header="{DynamicResource HistoryColumnDamage}" Binding="{Binding Damage}" ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource NumberHeader}" Width="130" MinWidth="130"/>
                                        <DataGridTextColumn Header="{DynamicResource HistoryColumnQuality}" Binding="{Binding Quality}" ElementStyle="{StaticResource Cell}" Width="100" MinWidth="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="{Binding BattleDamageEmptyText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Empty}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DamageBreakdowns.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="{DynamicResource HistoryReview}" IsEnabled="{Binding CanEditBattleReview}">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ItemsControl ItemsSource="{Binding ReviewTags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Display}" IsChecked="{Binding IsSelected}" Margin="0,0,20,10"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBox Width="200" MaxLength="24" Text="{Binding CustomReviewTag, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource HistoryCustomTag}"/>
                                <Button Content="{DynamicResource HistoryAddTag}" Click="AddReviewTag_Click" Margin="8,0,0,0"/>
                            </StackPanel>
                            <Grid Grid.Row="2">
                                <TextBox x:Name="ReviewNoteBox" Text="{Binding ReviewNote, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4000" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                                <TextBlock Text="{DynamicResource HistoryReviewNoteHint}" Foreground="{StaticResource TextSecondaryBrush}" IsHitTestVisible="False" Margin="10,8">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ReviewNote}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <DockPanel Grid.Row="3" Margin="0,12,0,0">
                                <Button Content="{DynamicResource HistorySaveReview}" Click="SaveReview_Click" x:Name="SaveReviewButton" DockPanel.Dock="Right" Margin="0"/>
                                <TextBlock Text="{DynamicResource HistoryDraftSavedHint}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
        <TextBlock x:Name="HistoryStatusText" Grid.Row="2" Text="{Binding StatusText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" Margin="0,12,0,0"/>
    </Grid>
</Window>
