<Window x:Class="ApeRadar.NoteEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource NoteEditWindowTitle}" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" SizeToContent="WidthAndHeight" ShowInTaskbar="False">
    <StackPanel Margin="20" Width="420">
        <TextBlock x:Name="TxtNotePlayerName" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <TextBlock Text="{DynamicResource NoteQuickOptionsTitle}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <WrapPanel x:Name="QuickOptionsPanel" Margin="-3,0,0,3"/>
        <Button Content="{DynamicResource NoteQuickOptionsManage}" HorizontalAlignment="Left" Padding="10,4" Margin="0,2,0,8" Click="BtnManageQuickOptions_Click"/>
        <Border x:Name="QuickOptionsEditor" Visibility="Collapsed" Background="#F4F7FB" BorderBrush="#C8D3E1" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{DynamicResource NoteQuickOptionsHint}" Foreground="#52657D" FontSize="11" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtQuickOptions" Height="82" TextWrapping="NoWrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="{DynamicResource NoteQuickOptionsReset}" MinWidth="76" Height="28" Margin="0,0,8,0" Click="BtnResetQuickOptions_Click"/>
                    <Button Content="{DynamicResource NoteQuickOptionsSave}" MinWidth="76" Height="28" Click="BtnSaveQuickOptions_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <TextBlock Text="{DynamicResource NoteEditWindowContentLabel}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <TextBox x:Name="TxtNote" Height="100" MaxLength="200" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="{DynamicResource BtnOK}" Width="90" Height="32" Margin="0,0,10,0" IsDefault="True" Click="BtnOK_Click"/>
            <Button Content="{DynamicResource BtnCancel}" Width="90" Height="32" IsCancel="True" Click="BtnCancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
