                                <TextBlock Text="{Binding ShipBattles_Solo, Converter={StaticResource CvtBattleData}}" HorizontalAlignment="Center" Margin="10" FontSize="{Binding Source={x:Static p:Settings.Default}, Path=DetailedStatisticsFontSize}"/>
                                <TextBlock Text="{Binding ShipWinrate_Solo, Converter={StaticResource CvtBattleData}, StringFormat={}{0:p2}}" HorizontalAlignment="Center" Margin="10" FontSize="{Binding Source={x:Static p:Settings.Default}, Path=DetailedStatisticsFontSize}"/>
                                <TextBlock Text="{Binding ShipAvgExpPerBattle_Solo, Converter={StaticResource CvtBattleData}, StringFormat={}{0:f0}}" HorizontalAlignment="Center" Margin="10" FontSize="{Binding Source={x:Static p:Settings.Default}, Path=DetailedStatisticsFontSize}"/>
                                <TextBlock Text="{Binding ShipAvgDmgPerBattle_Solo, Converter={StaticResource CvtBattleData}, StringFormat={}{0:f0}}" HorizontalAlignment="Center" Margin="10" FontSize="{Binding Source={x:Static p:Settings.Default}, Path=DetailedStatisticsFontSize}"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{DynamicResource DataGridToolTipDiv2}" HorizontalAlignment="Center" Margin="10" FontSize="{Binding Source={x:Static p:Settings.Default}, Path=DetailedStatisticsFontSize}"/>
                                <TextBlock Text="{Binding ShipBattles_Div2, Converter={StaticResource CvtBattleData}}" HorizontalAlignment="Center" Margin="10" FontSize="{Binding Source={x:Static p:Settings.Default}, Path=DetailedStatisticsFontSize}"/>
                                <TextBlock Text="{Binding ShipWinrate_Div2, Converter={StaticResource CvtBattleData}, StringFormat={}{0:p2}}" HorizontalAlignment="Center" Margin="10" FontSize="{Binding Source={x:Static p:Settings.Default}, Path=DetailedStatisticsFontSize}"/>
                                <TextBlock Text="{Binding ShipAvgExpPerBattle_Div2, Converter={StaticResource CvtBattleData}, StringFormat={}{0:f0}}" HorizontalAlignment="Center" Margin="10" FontSize="{Binding Source={x:Static p:Settings.Default}, Path=DetailedStatisticsFontSize}"/>
                                <TextBlock Text="{Binding ShipAvgDmgPerBattle_Div2, Converter={StaticResource CvtBattleData}, StringFormat={}{0:f0}}" HorizontalAlignment="Center" Margin="10" FontSize="{Binding Source={x:Static p:Settings.Default}, Path=DetailedStatisticsFontSize}"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{DynamicResource DataGridToolTipDiv3}" HorizontalAlignment="Center" Margin="10" FontSize="{Binding Source={x:Static p:Settings.Default}, Path=DetailedStatisticsFontSize}"/>
                                <TextBlock Text="{Binding ShipBattles_Div3, Converter={StaticResource CvtBattleData}}" HorizontalAlignment="Center" Margin="10" FontSize="{Binding Source={x:Static p:Settings.Default}, Path=DetailedStatisticsFontSize}"/>
                                <TextBlock Text="{Binding ShipWinrate_Div3, Converter={StaticResource CvtBattleData}, StringFormat={}{0:p2}}" HorizontalAlignment="Center" Margin="10" FontSize="{Binding Source={x:Static p:Settings.Default}, Path=DetailedStatisticsFontSize}"/>
                                <TextBlock Text="{Binding ShipAvgExpPerBattle_Div3, Converter={StaticResource CvtBattleData}, StringFormat={}{0:f0}}" HorizontalAlignment="Center" Margin="10" FontSize="{Binding Source={x:Static p:Settings.Default}, Path=DetailedStatisticsFontSize}"/>
                                <TextBlock Text="{Binding ShipAvgDmgPerBattle_Div3, Converter={StaticResource CvtBattleData}, StringFormat={}{0:f0}}" HorizontalAlignment="Center" Margin="10" FontSize="{Binding Source={x:Static p:Settings.Default}, Path=DetailedStatisticsFontSize}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <Border BorderBrush="#B8C2CC" BorderThickness="1" CornerRadius="4" Padding="10,7" Margin="5,8,5,2" MaxWidth="760"
                        Visibility="{Binding Source={x:Static p:Settings.Default}, Path=ShowTierPerformanceStats, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource TierStatsTitle}" FontWeight="Bold" Margin="0,0,0,4" FontSize="{Binding Source={x:Static p:Settings.Default}, Path=DetailedStatisticsFontSize}"/>
                        <TextBlock FontSize="{Binding Source={x:Static p:Settings.Default}, Path=DetailedStatisticsFontSize}" TextWrapping="Wrap">
                            <Run Text="{DynamicResource TierStatsExactPrefix}"/>
                            <Run Text="{Binding ShipTier, Converter={StaticResource CvtShipTier}}" FontWeight="SemiBold"/>
                            <Run Text=" · "/><Run Text="{Binding TierBattles, Converter={StaticResource CvtBattleData}, StringFormat={}{0:f0}}"/><Run Text="{DynamicResource TierStatsBattlesSuffix}"/>
                            <Run Text=" · "/><Run Text="{DynamicResource DataGridToolTipWinrate}"/><Run Text=" "/><Run Text="{Binding TierWinrate, Converter={StaticResource CvtBattleData}, StringFormat={}{0:p2}}" Foreground="{Binding TierWinrate, Converter={StaticResource CvtWinrateColor}}" FontWeight="SemiBold"/>
                            <Run Text=" · PR "/><Run Text="{Binding TierPR, Converter={StaticResource CvtBattleData}, StringFormat={}{0:f0}}" Foreground="{Binding TierPR, Converter={StaticResource CvtPRColor}}" FontWeight="SemiBold"/>
                        </TextBlock>
                        <TextBlock Text="{DynamicResource TierStatsSmallSample}" Foreground="#B45309" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding IsTierSampleSmall, Converter={StaticResource BoolToVisibility}}" FontSize="{Binding Source={x:Static p:Settings.Default}, Path=DetailedStatisticsFontSize}"/>
                        <TextBlock Margin="0,3,0,0" TextWrapping="Wrap" Visibility="{Binding HasTierReference, Converter={StaticResource BoolToVisibility}}" FontSize="{Binding Source={x:Static p:Settings.Default}, Path=DetailedStatisticsFontSize}">
                            <Run Text="{DynamicResource TierStatsReferencePrefix}"/>
                            <Run Text="{Binding TierReferenceMin, Converter={StaticResource CvtShipTier}}"/><Run Text="–"/><Run Text="{Binding TierReferenceMax, Converter={StaticResource CvtShipTier}}"/>
                            <Run Text=" · "/><Run Text="{Binding TierReferenceBattles, Converter={StaticResource CvtBattleData}, StringFormat={}{0:f0}}"/><Run Text="{DynamicResource TierStatsBattlesSuffix}"/>
                            <Run Text=" · "/><Run Text="{DynamicResource DataGridToolTipWinrate}"/><Run Text=" "/><Run Text="{Binding TierReferenceWinrate, Converter={StaticResource CvtBattleData}, StringFormat={}{0:p2}}" Foreground="{Binding TierReferenceWinrate, Converter={StaticResource CvtWinrateColor}}" FontWeight="SemiBold"/>
                            <Run Text=" · PR "/><Run Text="{Binding TierReferencePR, Converter={StaticResource CvtBattleData}, StringFormat={}{0:f0}}" Foreground="{Binding TierReferencePR, Converter={StaticResource CvtPRColor}}" FontWeight="SemiBold"/>
                        </TextBlock>
                        <TextBlock Margin="0,3,0,0" TextWrapping="Wrap" Visibility="{Binding HasRecognizedTierData, Converter={StaticResource BoolToVisibility}}" FontSize="{Binding Source={x:Static p:Settings.Default}, Path=DetailedStatisticsFontSize}">
                            <Run Text="{DynamicResource TierStatsMostPlayedPrefix}"/>
                            <Run Text="{Binding MostPlayedTier, Converter={StaticResource CvtShipTier}}" FontWeight="SemiBold"/>
                            <Run Text=" · "/><Run Text="{Binding MostPlayedTierBattles, Converter={StaticResource CvtBattleData}, StringFormat={}{0:f0}}"/><Run Text="{DynamicResource TierStatsBattlesSuffix}"/>
                            <Run Text="{DynamicResource TierStatsSharePrefix}"/><Run Text="{Binding MostPlayedTierShare, StringFormat={}{0:p0}}"/>
                        </TextBlock>
                        <TextBlock Text="{DynamicResource TierStatsLowTierBias}" Foreground="#B91C1C" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding IsLowTierBiased, Converter={StaticResource BoolToVisibility}}" FontSize="{Binding Source={x:Static p:Settings.Default}, Path=DetailedStatisticsFontSize}"/>
                        <TextBlock Text="{DynamicResource TierStatsReferenceNotice}" Foreground="#5B6470" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasTierReference, Converter={StaticResource BoolToVisibility}}" FontSize="{Binding Source={x:Static p:Settings.Default}, Path=DetailedStatisticsFontSize}"/>
                    </StackPanel>
                </Border>
                <Border BorderBrush="#FF8C00" BorderThickness="1,1,1,0" Margin="5,8,5,0" Visibility="{Binding RecentEncounterDetails, Converter={StaticResource CvtNoteVisibility}}"/>
                <StackPanel Margin="10,4,10,8" Visibility="{Binding RecentEncounterDetails, Converter={StaticResource CvtNoteVisibility}}">
                    <TextBlock Text="{DynamicResource ToolTipRecentEncounters}" FontWeight="Bold" FontSize="{Binding Source={x:Static p:Settings.Default}, Path=DetailedStatisticsFontSize}"/>
                    <TextBlock Text="{Binding RecentEncounterDetails}" TextWrapping="Wrap" FontSize="{Binding Source={x:Static p:Settings.Default}, Path=DetailedStatisticsFontSize}"/>
                </StackPanel>
            </StackPanel>
        </ToolTip>
        <Style x:Key="DataGridPlayerListRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="ContextMenu" Value="{StaticResource RowMenu}"/>
            <Setter Property="Focusable" Value="True"/>
            <EventSetter Event="MouseEnter" Handler="RosterRow_MouseEnter"/>
            <EventSetter Event="MouseLeave" Handler="RosterRow_MouseLeave"/>
        </Style>



    </Window.Resources>

    <Grid x:Name="MainWindowGrid" Margin="10" PreviewKeyDown="MainWindowGrid_PreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SurfaceCardStyle}" Padding="10,5" Margin="0,0,0,7">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="6,0,8,0" ToolTip="https://lxdev.org/aperadar/">
                        <Run Text="{Binding Source={x:Static p:Settings.Default}, Path=SoftwareVersion, Mode=OneWay}"/>
                        <Run Text=" · "/><Run Text="Build "/><Run Text="{Binding Source={x:Static p:Settings.Default}, Path=SoftwareDate, Mode=OneWay}"/>
                    </TextBlock>
                    <Button x:Name="BtnToggleAnalysis" Content="{DynamicResource BtnAnalysis}" MinWidth="112" Margin="4,0,8,0" Click="BtnToggleAnalysis_Click"/>
                    <ComboBox x:Name="ComboBoxLanguage" DisplayMemberPath="Content" SelectedValuePath="Value" Width="92" SelectionChanged="ComboBoxLanguage_SelectionChanged"/>
                </StackPanel>
                <TextBlock x:Name="LabelGamePathIsSetOrNot" Text="{Binding Source={x:Static p:Settings.Default}, Path=GamePath, Converter={StaticResource CvtGamePathIsSetText}}" Foreground="{Binding Source={x:Static p:Settings.Default}, Path=GamePath, Converter={StaticResource CvtGamePathIsSetColor}}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Grid x:Name="MainContentGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="AnalysisHostColumn" Width="0"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="RosterContentGrid" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" Padding="10,6" BorderBrush="#67A98A" BorderThickness="0,0,0,3">
                    <DockPanel>
                        <TextBlock Text="{DynamicResource LabelAllies}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <WrapPanel HorizontalAlignment="Right">
                            <TextBlock Text="{DynamicResource LabelAverageAccountWinrate}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,4,0"/><TextBlock Text="{Binding AllyAvgAccountWinrate, StringFormat={}{0:p1}}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource LabelAverageBattleCount}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,4,0"/><TextBlock Text="{Binding AllyAvgBattleCount, StringFormat={}{0:f0}}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                            <TextBlock Text="PR " Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{Binding AllyAvgPR, StringFormat={}{0:f0}}" FontWeight="SemiBold"/>
                        </WrapPanel>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource SurfaceCardStyle}" Padding="10,6" BorderBrush="#D47A7A" BorderThickness="0,0,0,3">
                    <DockPanel>
                        <TextBlock Text="{DynamicResource LabelEnemies}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <WrapPanel HorizontalAlignment="Right">
                            <TextBlock Text="{DynamicResource LabelAverageAccountWinrate}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,4,0"/><TextBlock Text="{Binding EnemyAvgAccountWinrate, StringFormat={}{0:p1}}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource LabelAverageBattleCount}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,4,0"/><TextBlock Text="{Binding EnemyAvgBattleCount, StringFormat={}{0:f0}}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                            <TextBlock Text="PR " Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{Binding EnemyAvgPR, StringFormat={}{0:f0}}" FontWeight="SemiBold"/>
                        </WrapPanel>
                    </DockPanel>
                </Border>
            </Grid>
            <Border Grid.Row="1" Margin="0,0,0,6" Padding="8,5" CornerRadius="5"
                    Background="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=RosterStatus.Background}"
                    BorderBrush="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=RosterStatus.Accent}" BorderThickness="1"
                    Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=RosterStatus.IsVisible, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <ProgressBar DockPanel.Dock="Right" Width="90" Height="4" Margin="10,0,0,0" IsIndeterminate="True"
                                 Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=RosterStatus.IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=RosterStatus.Text}"
                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=RosterStatus.Accent}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
            <Grid x:Name="RosterTablesGrid" Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <DataGrid x:Name="DataGridAlliesList" Grid.Column="0" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" CanUserResizeColumns="False" SelectionMode="Single"
                          ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}, Path=AlliesRosterRows}" CanUserReorderColumns="False" CanUserSortColumns="False"
                          GridLinesVisibility="None"
                          RowStyle="{StaticResource DataGridPlayerListRowStyle}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ColumnHeaderHeight="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}, Path=EffectiveColumnHeaderHeight}" AlternationCount="2"
                          ScrollViewer.ScrollChanged="RosterDataGrid_ScrollChanged"/>
                <DataGrid x:Name="DataGridEnemiesList" Grid.Column="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" CanUserResizeColumns="False" SelectionMode="Single"
                          ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}, Path=EnemiesRosterRows}" CanUserReorderColumns="False" CanUserSortColumns="False"
                          GridLinesVisibility="None"
                          RowStyle="{StaticResource DataGridPlayerListRowStyle}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ColumnHeaderHeight="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}, Path=EffectiveColumnHeaderHeight}" AlternationCount="2"
                          ScrollViewer.ScrollChanged="RosterDataGrid_ScrollChanged"/>
            </Grid>
        </Grid>

            <Border x:Name="AnalysisPanel" Grid.Column="0" Grid.ColumnSpan="2" Width="420" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                HorizontalAlignment="Right" Style="{StaticResource SurfaceCardStyle}" Padding="10" Panel.ZIndex="30" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="#29415F" BlurRadius="18" ShadowDepth="-3" Opacity="0.22"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="3*"/><RowDefinition Height="1*"/><RowDefinition Height="92"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <DockPanel Margin="4,0,0,6">
                        <Button DockPanel.Dock="Right" Content="×" Width="30" Height="30" Padding="0" Margin="4,0,0,0" Click="BtnToggleAnalysis_Click" ToolTip="{DynamicResource BtnCloseAnalysis}"/>
                        <TextBlock Text="{DynamicResource AnalysisPanelTitle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <WrapPanel>
                        <StackPanel Margin="4"><TextBlock Text="{DynamicResource LabelDisplayStyle}"/><ComboBox x:Name="ComboBoxMirrored" DisplayMemberPath="Content" SelectedValuePath="Value" Width="100" SelectionChanged="ComboBoxMirrored_SelectionChanged"/></StackPanel>
                        <StackPanel Margin="4"><TextBlock Text="{DynamicResource LabelPlayerListSortBy}"/><ComboBox x:Name="ComboBoxSortBy" DisplayMemberPath="Content" SelectedValuePath="Value" Width="190" SelectionChanged="ComboBoxSortBy_SelectionChanged"/></StackPanel>
                        <StackPanel Margin="4"><TextBlock Text="{DynamicResource LabelPlayerNames}"/><ComboBox x:Name="ComboBoxPlayerNamesVisibility" DisplayMemberPath="Content" SelectedValuePath="Value" Width="100" SelectionChanged="ComboBoxPlayerNamesVisibility_SelectionChanged"/></StackPanel>
                        <StackPanel Margin="4"><TextBlock Text="{DynamicResource LabelChartType}"/><ComboBox x:Name="ComboBoxChartType" DisplayMemberPath="Content" SelectedValuePath="Value" Width="190" SelectionChanged="ComboBoxChartType_SelectionChanged"/></StackPanel>
                    </WrapPanel>
                </StackPanel>
                <lvc:CartesianChart Grid.Row="1" x:Name="WinrateChart" TooltipTextSize="13" TooltipFindingStrategy="CompareAllTakeClosest" Margin="0,-8,0,-8"/>
                <lvc:CartesianChart Grid.Row="2" x:Name="KDEChart" Margin="0,2,0,0"/>
                <TextBox Grid.Row="3" x:Name="TxtOutputText" Margin="0,6,0,0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding Source={x:Static p:Settings.Default}, Path=OutputTextUnlock}" FontSize="{Binding Source={x:Static p:Settings.Default}, Path=OutputTextFontSize}"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource SurfaceCardStyle}" Padding="5" Margin="0,7,0,0">
            <DockPanel LastChildFill="True">
                <WrapPanel x:Name="MainFooterButtons" DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnRefresh" Content="{DynamicResource BtnRefresh}" MinWidth="72" Click="BtnRefresh_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                    <Button x:Name="BtnOpen" Content="{DynamicResource BtnOpen}" MinWidth="72" Click="BtnOpen_Click"/>
                    <Button x:Name="BtnHistory" Content="{DynamicResource BtnHistory}" MinWidth="72" Click="BtnHistory_Click"/>
                    <Button x:Name="BtnSoftwareUpdate" Content="{DynamicResource BtnSoftwareUpdate}" MinWidth="72" Click="BtnSoftwareUpdate_Click"/>
                    <Button x:Name="BtnConfig" Content="{DynamicResource BtnConfig}" MinWidth="72" Click="BtnConfig_Click"/>
                    <Button x:Name="BtnScreenshot" Content="{DynamicResource BtnScreenshot}" MinWidth="72" Click="BtnScreenshot_Click"/>
                    <Button x:Name="BtnMore" Content="{DynamicResource BtnMore}" MinWidth="72" Click="BtnMore_Click" Visibility="Collapsed">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource BtnSoftwareUpdate}" Click="BtnSoftwareUpdate_Click"/>
                                <MenuItem Header="{DynamicResource BtnConfig}" Click="BtnConfig_Click"/>
                                <MenuItem Header="{DynamicResource BtnScreenshot}" Click="BtnScreenshot_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </WrapPanel>
                <Border DockPanel.Dock="Left" x:Name="CurrentSessionSummaryCard" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,8,0" Padding="9,4" MaxWidth="650"
                        BorderBrush="#CCD6E2" BorderThickness="1" CornerRadius="5" Background="#F8FAFD" Cursor="Hand"
                        MouseLeftButtonDown="CurrentSessionSummaryCard_MouseLeftButtonDown" ToolTip="{DynamicResource MainSessionOpenHint}">
                <WrapPanel>
                    <TextBlock Text="{DynamicResource MainSessionTitle}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{DynamicResource MainSessionBattles}" VerticalAlignment="Center"/><TextBlock x:Name="TxtMainSessionBattles" Text="-" FontWeight="SemiBold" VerticalAlignment="Center" Margin="3,0,10,0"/>
                    <TextBlock x:Name="TxtMainSessionResultLabel" Text="{DynamicResource HistoryWinrate}" VerticalAlignment="Center"/><TextBlock x:Name="TxtMainSessionWinrate" Text="-" FontWeight="SemiBold" VerticalAlignment="Center" Margin="3,0,10,0"/>
                    <TextBlock Text="{DynamicResource HistoryAverageDamage}" VerticalAlignment="Center"/><TextBlock x:Name="TxtMainSessionDamage" Text="-" FontWeight="SemiBold" VerticalAlignment="Center" Margin="3,0,10,0"/>
                    <TextBlock Text="PR" VerticalAlignment="Center"/><TextBlock x:Name="TxtMainSessionPr" Text="-" FontWeight="SemiBold" VerticalAlignment="Center" Margin="3,0,0,0"/>
                </WrapPanel>
                </Border>
                <Grid Margin="0,0,6,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button x:Name="BtnToggleNotifications" Grid.Column="0" Content="＋" Width="32" Height="32" Padding="0" Margin="0" Click="BtnToggleNotifications_Click" ToolTip="{DynamicResource NotificationExpand}"/>
                    <DataGrid x:Name="DataGridNotificationMessages" Grid.Column="1" Height="32" HeadersVisibility="None" RowHeight="28" Margin="5,0,0,0" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" CanUserResizeColumns="False" SelectionMode="Single" ItemsSource="{Binding Source={x:Static utils:NotificationMessageUtils.NotificationMessageCollection}}" CanUserReorderColumns="False" CanUserSortColumns="False" VerticalScrollBarVisibility="Hidden">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="66"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Time, StringFormat='{}{0:HH:mm:ss}'}" FontSize="10" Foreground="{Binding Type, Converter={StaticResource CvtNotificationMessageColor}}" Margin="4,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="*" MinWidth="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Message}" FontSize="11" Foreground="{Binding Type, Converter={StaticResource CvtNotificationMessageColor}}" Margin="4,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </DockPanel>
        </Border>

        <Popup x:Name="NotificationPopup" PlacementTarget="{Binding ElementName=BtnToggleNotifications}" Placement="Top" StaysOpen="False" AllowsTransparency="True" Closed="NotificationPopup_Closed">
            <Border Width="560" Height="150" Style="{StaticResource SurfaceCardStyle}" Padding="6" Margin="0,0,0,5">
                <Border.Effect><DropShadowEffect Color="#29415F" BlurRadius="14" ShadowDepth="2" Opacity="0.20"/></Border.Effect>
                <DataGrid x:Name="DataGridNotificationHistory" HeadersVisibility="Column" RowHeight="27" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" CanUserResizeColumns="False" ItemsSource="{Binding Source={x:Static utils:NotificationMessageUtils.NotificationMessageCollection}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource DataGridHeaderTime}" Binding="{Binding Time, StringFormat='{}{0:HH:mm:ss}'}" Width="78"/>
                        <DataGridTextColumn Header="{DynamicResource DataGridHeaderMessage}" Binding="{Binding Message}" Width="*" MinWidth="360"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Popup>

        <Popup x:Name="PlayerDetailPopup" Placement="Custom" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade"
               Closed="PlayerDetailPopup_Closed" MouseEnter="PlayerDetailPopup_MouseEnter" MouseLeave="PlayerDetailPopup_MouseLeave">
            <Border x:Name="PlayerDetailCardBorder" Width="560" MaxWidth="560" MaxHeight="720" Style="{StaticResource SurfaceCardStyle}" Padding="10" Margin="6">
                <Border.Effect><DropShadowEffect Color="#29415F" BlurRadius="18" ShadowDepth="3" Opacity="0.24"/></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,7">
                        <Button x:Name="BtnClosePlayerDetail" DockPanel.Dock="Right" Content="×" Width="30" Height="28" Padding="0" Margin="4,0,0,0" Click="BtnClosePlayerDetail_Click" ToolTip="{DynamicResource DetailClose}"/>
                        <Button x:Name="BtnCopyPlayerDetail" DockPanel.Dock="Right" Content="{DynamicResource DetailCopySummary}" MinWidth="88" Height="28" Padding="8,2" Margin="4,0,0,0" Click="BtnCopyPlayerDetail_Click"/>
                        <TextBlock Text="{DynamicResource DetailHoverMode}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                        <controls:PlayerDetailCard x:Name="PlayerDetailCardContent"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Popup>
    </Grid>


</Window>
