                            <Run Text=" · "/><Run Text="{Binding MostPlayedTierBattles, Converter={StaticResource CvtBattleData}, StringFormat={}{0:f0}}"/><Run Text="{DynamicResource TierStatsBattlesSuffix}"/>
                            <Run Text="{DynamicResource TierStatsSharePrefix}"/><Run Text="{Binding MostPlayedTierShare, StringFormat={}{0:p0}}"/>
                        </TextBlock>
                        <TextBlock Text="{DynamicResource TierStatsLowTierBias}" Foreground="#B91C1C" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding IsLowTierBiased, Converter={StaticResource BoolToVisibility}}" FontSize="{Binding Source={x:Static p:Settings.Default}, Path=DetailedStatisticsFontSize}"/>
                        <TextBlock Text="{DynamicResource TierStatsReferenceNotice}" Foreground="#5B6470" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasTierReference, Converter={StaticResource BoolToVisibility}}" FontSize="{Binding Source={x:Static p:Settings.Default}, Path=DetailedStatisticsFontSize}"/>
                    </StackPanel>
                </Border>
                <Border BorderBrush="#FF8C00" BorderThickness="1,1,1,0" Margin="5,8,5,0" Visibility="{Binding RecentEncounterDetails, Converter={StaticResource CvtNoteVisibility}}"/>
                <StackPanel Margin="10,4,10,8" Visibility="{Binding RecentEncounterDetails, Converter={StaticResource CvtNoteVisibility}}">
                    <TextBlock Text="{DynamicResource ToolTipRecentEncounters}" FontWeight="Bold" FontSize="{Binding Source={x:Static p:Settings.Default}, Path=DetailedStatisticsFontSize}"/>
                    <TextBlock Text="{Binding RecentEncounterDetails}" TextWrapping="Wrap" FontSize="{Binding Source={x:Static p:Settings.Default}, Path=DetailedStatisticsFontSize}"/>
                </StackPanel>
            </StackPanel>
        </ToolTip>
        <Style x:Key="DataGridPlayerListRowStyle" TargetType="DataGridRow">
            <Setter Property="ContextMenu" Value="{StaticResource RowMenu}"/>
            <Setter Property="ToolTip" Value="{StaticResource ToolTipPlayerDetails}"/>
        </Style>



    </Window.Resources>

    <Grid x:Name="MainWindowGrid" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="RosterColumn" Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition x:Name="AnalysisColumn" Width="360"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource SurfaceCardStyle}" Padding="10,6" Margin="0,0,0,8">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="ComboBoxLanguage" DisplayMemberPath="Content" SelectedValuePath="Value" Width="92" SelectionChanged="ComboBoxLanguage_SelectionChanged"/>
                </StackPanel>
                <Button x:Name="BtnToggleAnalysis" DockPanel.Dock="Right" Content="{DynamicResource BtnAnalysis}" MinWidth="104" Margin="8,0" Click="BtnToggleAnalysis_Click"/>
                <TextBlock x:Name="LabelGamePathIsSetOrNot" Text="{Binding Source={x:Static p:Settings.Default}, Path=GamePath, Converter={StaticResource CvtGamePathIsSetText}}" Foreground="{Binding Source={x:Static p:Settings.Default}, Path=GamePath, Converter={StaticResource CvtGamePathIsSetColor}}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" Padding="10,6">
                    <DockPanel>
                        <TextBlock Text="{DynamicResource LabelAllies}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <WrapPanel HorizontalAlignment="Right">
                            <TextBlock Text="{DynamicResource LabelAverageAccountWinrate}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,4,0"/><TextBlock Text="{Binding AllyAvgAccountWinrate, StringFormat={}{0:p1}}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource LabelAverageBattleCount}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,4,0"/><TextBlock Text="{Binding AllyAvgBattleCount, StringFormat={}{0:f0}}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                            <TextBlock Text="PR " Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{Binding AllyAvgPR, StringFormat={}{0:f0}}" FontWeight="SemiBold"/>
                        </WrapPanel>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource SurfaceCardStyle}" Padding="10,6">
                    <DockPanel>
                        <TextBlock Text="{DynamicResource LabelEnemies}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <WrapPanel HorizontalAlignment="Right">
                            <TextBlock Text="{DynamicResource LabelAverageAccountWinrate}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,4,0"/><TextBlock Text="{Binding EnemyAvgAccountWinrate, StringFormat={}{0:p1}}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource LabelAverageBattleCount}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,4,0"/><TextBlock Text="{Binding EnemyAvgBattleCount, StringFormat={}{0:f0}}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                            <TextBlock Text="PR " Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="{Binding EnemyAvgPR, StringFormat={}{0:f0}}" FontWeight="SemiBold"/>
                        </WrapPanel>
                    </DockPanel>
                </Border>
            </Grid>
            <Border Grid.Row="1" Margin="0,0,0,6" Padding="8,5" CornerRadius="5"
                    Background="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=RosterStatus.Background}"
                    BorderBrush="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=RosterStatus.Accent}" BorderThickness="1"
                    Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=RosterStatus.IsVisible, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <ProgressBar DockPanel.Dock="Right" Width="90" Height="4" Margin="10,0,0,0" IsIndeterminate="True"
                                 Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=RosterStatus.IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=RosterStatus.Text}"
                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=RosterStatus.Accent}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
            <Grid x:Name="RosterTablesGrid" Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <DataGrid x:Name="DataGridAlliesList" Grid.Column="0" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" SelectionMode="Single" ItemsSource="{Binding Allies}" CanUserReorderColumns="False" CanUserSortColumns="False" RowStyle="{StaticResource DataGridPlayerListRowStyle}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                <DataGrid x:Name="DataGridEnemiesList" Grid.Column="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" SelectionMode="Single" ItemsSource="{Binding Enemies}" CanUserReorderColumns="False" CanUserSortColumns="False" RowStyle="{StaticResource DataGridPlayerListRowStyle}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Grid>

        <Border x:Name="AnalysisPanel" Grid.Row="1" Grid.Column="2" Style="{StaticResource SurfaceCardStyle}" Padding="8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="3*"/><RowDefinition Height="1*"/><RowDefinition Height="92"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="{DynamicResource AnalysisPanelTitle}" FontSize="16" FontWeight="SemiBold" Margin="4,0,4,6"/>
                    <WrapPanel>
                        <StackPanel Margin="4"><TextBlock Text="{DynamicResource LabelDisplayStyle}"/><ComboBox x:Name="ComboBoxMirrored" DisplayMemberPath="Content" SelectedValuePath="Value" Width="100" SelectionChanged="ComboBoxMirrored_SelectionChanged"/></StackPanel>
                        <StackPanel Margin="4"><TextBlock Text="{DynamicResource LabelPlayerListSortBy}"/><ComboBox x:Name="ComboBoxSortBy" DisplayMemberPath="Content" SelectedValuePath="Value" Width="190" SelectionChanged="ComboBoxSortBy_SelectionChanged"/></StackPanel>
                        <StackPanel Margin="4"><TextBlock Text="{DynamicResource LabelPlayerNames}"/><ComboBox x:Name="ComboBoxPlayerNamesVisibility" DisplayMemberPath="Content" SelectedValuePath="Value" Width="100" SelectionChanged="ComboBoxPlayerNamesVisibility_SelectionChanged"/></StackPanel>
                        <StackPanel Margin="4"><TextBlock Text="{DynamicResource LabelChartType}"/><ComboBox x:Name="ComboBoxChartType" DisplayMemberPath="Content" SelectedValuePath="Value" Width="190" SelectionChanged="ComboBoxChartType_SelectionChanged"/></StackPanel>
                    </WrapPanel>
                </StackPanel>
                <lvc:CartesianChart Grid.Row="1" x:Name="WinrateChart" TooltipTextSize="13" TooltipFindingStrategy="CompareAllTakeClosest" Margin="0,-8,0,-8"/>
                <lvc:CartesianChart Grid.Row="2" x:Name="KDEChart" Margin="0,2,0,0"/>
                <TextBox Grid.Row="3" x:Name="TxtOutputText" Margin="0,6,0,0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding Source={x:Static p:Settings.Default}, Path=OutputTextUnlock}" FontSize="{Binding Source={x:Static p:Settings.Default}, Path=OutputTextFontSize}"/>
            </Grid>
        </Border>

        <Grid x:Name="MainFooterTop" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,5,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button x:Name="BtnToggleNotifications" Grid.Column="0" Content="+" Width="32" Height="32" Margin="0" Click="BtnToggleNotifications_Click" ToolTip="{DynamicResource NotificationExpand}"/>
            <DataGrid x:Name="DataGridNotificationMessages" Grid.Column="1" Height="32" MaxHeight="120" HeadersVisibility="None" RowHeight="26" Margin="5,0,0,0" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" CanUserResizeColumns="False" SelectionMode="Single" ItemsSource="{Binding Source={x:Static utils:NotificationMessageUtils.NotificationMessageCollection}}" CanUserReorderColumns="False" CanUserSortColumns="False">
                <DataGrid.Resources>
                    <DataTemplate x:Key="TimeHeaderTemplate">
                        <TextBlock Text="{DynamicResource DataGridHeaderTime}" FontSize="11"/>
                    </DataTemplate>
                    <DataTemplate x:Key="TimeTemplate">
                        <TextBlock Text="{Binding Time, StringFormat='{}{0:HH:mm:ss}'}" FontSize="11" Foreground="{Binding Type, Converter={StaticResource CvtNotificationMessageColor}}" Margin="5,0,0,0"/>
                    </DataTemplate>
                    <DataTemplate x:Key="MessageHeaderTemplate">
                        <TextBlock Text="{DynamicResource DataGridHeaderMessage}" FontSize="11"/>
                    </DataTemplate>
                    <DataTemplate x:Key="MessageTemplate">
                        <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{Binding Type, Converter={StaticResource CvtNotificationMessageColor}}" Margin="5,0,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}"/>
                    </DataTemplate>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn HeaderTemplate="{StaticResource TimeHeaderTemplate}" CellTemplate="{StaticResource TimeTemplate}" Width="72"/>
                    <DataGridTemplateColumn HeaderTemplate="{StaticResource MessageHeaderTemplate}" CellTemplate="{StaticResource MessageTemplate}" Width="*" MinWidth="220"/>
                </DataGrid.Columns>
            </DataGrid>
            </Grid>
            <WrapPanel x:Name="MainFooterButtons" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="540">
                <Button x:Name="BtnRefresh" Content="{DynamicResource BtnRefresh}" MinWidth="78" Click="BtnRefresh_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                <Button x:Name="BtnOpen" Content="{DynamicResource BtnOpen}" MinWidth="78" Click="BtnOpen_Click"/>
                <Button x:Name="BtnHistory" Content="{DynamicResource BtnHistory}" MinWidth="78" Click="BtnHistory_Click"/>
                <Button x:Name="BtnSoftwareUpdate" Content="{DynamicResource BtnSoftwareUpdate}" MinWidth="78" Click="BtnSoftwareUpdate_Click"/>
                <Button x:Name="BtnConfig" Content="{DynamicResource BtnConfig}" MinWidth="78" Click="BtnConfig_Click"/>
                <Button x:Name="BtnScreenshot" Content="{DynamicResource BtnScreenshot}" MinWidth="78" Click="BtnScreenshot_Click"/>
            </WrapPanel>
        </Grid>
        <Grid x:Name="MainFooterBottom" Grid.Row="3" Grid.ColumnSpan="3" Margin="0,5,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" x:Name="CurrentSessionSummaryCard" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,8,0" Padding="10,4" MaxWidth="760"
                    BorderBrush="#CCD6E2" BorderThickness="1" CornerRadius="5" Background="#F8FAFD" Cursor="Hand"
                    MouseLeftButtonDown="CurrentSessionSummaryCard_MouseLeftButtonDown" ToolTip="{DynamicResource MainSessionOpenHint}">
                <WrapPanel>
                    <TextBlock Text="{DynamicResource MainSessionTitle}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{DynamicResource MainSessionBattles}" VerticalAlignment="Center"/><TextBlock x:Name="TxtMainSessionBattles" Text="-" FontWeight="SemiBold" VerticalAlignment="Center" Margin="3,0,10,0"/>
                    <TextBlock x:Name="TxtMainSessionResultLabel" Text="{DynamicResource HistoryWinrate}" VerticalAlignment="Center"/><TextBlock x:Name="TxtMainSessionWinrate" Text="-" FontWeight="SemiBold" VerticalAlignment="Center" Margin="3,0,10,0"/>
                    <TextBlock Text="{DynamicResource HistoryAverageDamage}" VerticalAlignment="Center"/><TextBlock x:Name="TxtMainSessionDamage" Text="-" FontWeight="SemiBold" VerticalAlignment="Center" Margin="3,0,10,0"/>
                    <TextBlock Text="PR" VerticalAlignment="Center"/><TextBlock x:Name="TxtMainSessionPr" Text="-" FontWeight="SemiBold" VerticalAlignment="Center" Margin="3,0,0,0"/>
                </WrapPanel>
            </Border>
            <StackPanel x:Name="MainFooterAbout" Grid.Column="1" Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Right">
                <TextBlock HorizontalAlignment="Right" FontSize="11">
                    <Run Text="{DynamicResource WindowTitleApeRadar}"/>
                    <Run Text="{Binding Source={x:Static p:Settings.Default}, Mode=OneWay,Path=SoftwareVersion}"/>
                    <Run Text="Build"/>
                    <Run Text="{Binding Source={x:Static p:Settings.Default}, Mode=OneWay,Path=SoftwareDate}"/>
                </TextBlock>
                <TextBlock Text="{DynamicResource LabelAboutLine1}" HorizontalAlignment="Right" FontSize="11" Margin="0,5,0,5"/>
                <TextBlock HorizontalAlignment="Right" FontSize="11">
                    <Run Text="{DynamicResource LabelAboutLine2Part1}"/>
                    <Hyperlink x:Name="HyperLinkApeRadarWebsite" NavigateUri="https://lxdev.org/aperadar/" RequestNavigate="HyperLinkApeRadarWebsite_RequestNavigate">https://lxdev.org/aperadar/</Hyperlink>
                    <Run Text="{DynamicResource LabelAboutLine2Part2}"/>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Grid>


</Window>
