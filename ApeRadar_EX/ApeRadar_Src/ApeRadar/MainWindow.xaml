                        <TextBlock Text="{DynamicResource DataGridToolTipShipPR}" HorizontalAlignment="Center" FontSize="15" Margin="5,0,5,5"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </ToolTip>
        <Style x:Key="DataGridStatisticsColumnHeaderMirroredStyle" TargetType="DataGridColumnHeader">
            <Setter Property="ToolTip" Value="{StaticResource ToolTipStatisticsLegendMirrored}"/>
        </Style>

        <DataTemplate x:Key="NameHeaderTemplate">
            <TextBlock Text="{DynamicResource DataGridHeaderPlayer}" FontSize="15"/>
        </DataTemplate>
        <DataTemplate x:Key="NameTemplate">
            <Grid VerticalAlignment="Center" ClipToBounds="True">
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" FontSize="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}, Path=EffectivePlayerFontSize}" Margin="5,0" Foreground="{Binding WatchStatus, Converter={StaticResource CvtWatchStatusColor}}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                    <Run Text="{Binding ClanTag, Converter={StaticResource CvtPlayerNamesVisibility}}"/> <Run Text="{Binding Name, Converter={StaticResource CvtPlayerNamesVisibility}}"/> <Run BaselineAlignment="Superscript" FontSize="12" Text="{Binding Karma, Converter={StaticResource CvtBattleData}}"/><Run Text="{Binding WatchStatus, Converter={StaticResource CvtWatchStatusIcon}}"/><Run Text="{Binding Note, Converter={StaticResource CvtNoteIcon}}"/><Run Foreground="#FFD700" Text="{Binding CustomMarkerIcon, Mode=OneWay}"/><Run Foreground="#FF8C00" Text="{Binding RecentEncounterIcon, Mode=OneWay}"/>
                </TextBlock>
                <Grid Grid.Row="1" Margin="5,0" ClipToBounds="True">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}, Path=EffectivePlayerFontSize}" Foreground="{Binding WatchStatus, Converter={StaticResource CvtWatchStatusColor}}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"><Run Text="{Binding ShipTier, Converter={StaticResource CvtShipTier}}"/> <Run Text="{Binding ShipName}"/></TextBlock>
                    <utils:ShipTypeIconBadge Grid.Column="1" ShipType="{Binding ShipType}" TintBrush="{Binding Relation, Converter={StaticResource CvtShipRelationBrush}}" Margin="4,0,0,0"/>
                </Grid>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="StatisticsHeaderTemplate">
            <Grid Margin="-4,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Row="0" Grid.Column="0">
                    <StackPanel Orientation="Vertical" Width="110" Visibility="{Binding Source={x:Static p:Settings.Default}, Path=AccountWinrateVisibility, Converter={StaticResource CvtDataGridColumnVisibility}}">
                        <TextBlock Text="{DynamicResource DataGridHeaderStatisticsAccount}" HorizontalAlignment="Center" FontSize="15"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="0" Grid.Column="1">
                    <StackPanel Orientation="Vertical" Width="64" Visibility="{Binding Source={x:Static p:Settings.Default}, Path=WeightedWinrateVisibility, Converter={StaticResource CvtDataGridColumnVisibility}}">
                        <TextBlock Text="{DynamicResource DataGridHeaderStatisticsWeighted}" HorizontalAlignment="Center" FontSize="15"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="0" Grid.Column="2">
                    <StackPanel Orientation="Vertical" Width="114" Visibility="{Binding Source={x:Static p:Settings.Default}, Path=ShipWinrateVisibility, Converter={StaticResource CvtDataGridColumnVisibility}}">
                        <TextBlock Text="{DynamicResource DataGridHeaderStatisticsShip}" HorizontalAlignment="Center" FontSize="15"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="0" Grid.Column="3">
                    <StackPanel Orientation="Vertical" Width="132" Visibility="{Binding Source={x:Static p:Settings.Default}, Path=ShowTierPerformanceStats, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{DynamicResource DataGridHeaderStatisticsTier}" HorizontalAlignment="Center" FontSize="15"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="0" Grid.Column="4">
                    <StackPanel Orientation="Vertical" Width="54" Visibility="{Binding Source={x:Static p:Settings.Default}, Path=PRVisibility, Converter={StaticResource CvtDataGridColumnVisibility}}">
                        <TextBlock Text="{DynamicResource DataGridHeaderStatisticsPR}" HorizontalAlignment="Center" FontSize="15" ToolTip="{DynamicResource ToolTipPR}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="StatisticsTemplate">
            <Grid VerticalAlignment="Center" ClipToBounds="True">
                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="64"/><ColumnDefinition Width="114"/><ColumnDefinition Width="132"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" ClipToBounds="True" Visibility="{Binding Source={x:Static p:Settings.Default}, Path=AccountWinrateVisibility, Converter={StaticResource CvtDataGridColumnVisibility}}">
                    <TextBlock Text="{Binding Battles, Converter={StaticResource CvtBattleData}}" TextAlignment="Center" Foreground="{Binding Source={x:Static p:Settings.Default}, Path=AccountWinrateVisibility, Converter={StaticResource CvtDataGridColumnFadedColor}}" FontSize="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}, Path=EffectiveStatisticsFontSize}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="{Binding AccountWinrate, Converter={StaticResource CvtBattleData}, StringFormat={}{0:p2}}" Foreground="{Binding Source={x:Static p:Settings.Default}, Path=AccountWinrateVisibility, Converter={StaticResource CvtDataGridColumnFadedColor}}" FontSize="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}, Path=EffectiveStatisticsFontSize}"/><TextBlock Text=" · " Visibility="{Binding Source={x:Static p:Settings.Default}, Path=AccountAvgExpVisibility, Converter={StaticResource CvtDataGridColumnVisibility}}"/><TextBlock Text="{Binding AvgExpPerBattle, Converter={StaticResource CvtBattleData}, StringFormat={}{0:f0}}" Foreground="{Binding Source={x:Static p:Settings.Default}, Path=AccountAvgExpVisibility, Converter={StaticResource CvtDataGridColumnFadedColor}}" FontSize="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}, Path=EffectiveStatisticsFontSize}" Visibility="{Binding Source={x:Static p:Settings.Default}, Path=AccountAvgExpVisibility, Converter={StaticResource CvtDataGridColumnVisibility}}"/></StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" ClipToBounds="True" Visibility="{Binding Source={x:Static p:Settings.Default}, Path=WeightedWinrateVisibility, Converter={StaticResource CvtDataGridColumnVisibility}}"><TextBlock Text=" "/><TextBlock Text="{Binding WeightedWinrate, Converter={StaticResource CvtBattleData}, StringFormat={}{0:p2}}" TextAlignment="Center" Foreground="{Binding Source={x:Static p:Settings.Default}, Path=WeightedWinrateVisibility, Converter={StaticResource CvtDataGridColumnFadedColor}}" FontSize="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}, Path=EffectiveStatisticsFontSize}"/></StackPanel>
                <StackPanel Grid.Column="2" ClipToBounds="True" Visibility="{Binding Source={x:Static p:Settings.Default}, Path=ShipWinrateVisibility, Converter={StaticResource CvtDataGridColumnVisibility}}" TextElement.FontSize="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}, Path=EffectiveStatisticsFontSize}" TextElement.Foreground="{Binding Source={x:Static p:Settings.Default}, Path=ShipWinrateVisibility, Converter={StaticResource CvtDataGridColumnFadedColor}}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="{Binding ShipBattles, Converter={StaticResource CvtBattleData}}"/><TextBlock Text=" · "/><TextBlock Text="{Binding ShipWinrate, Converter={StaticResource CvtBattleData}, StringFormat={}{0:p2}}"/></StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="{Binding ShipAvgDmgPerBattle, Converter={StaticResource CvtBattleData}, StringFormat={}{0:f0}}" Visibility="{Binding Source={x:Static p:Settings.Default}, Path=ShipAvgDmgVisibility, Converter={StaticResource CvtDataGridColumnVisibility}}"/><TextBlock Text=" · " Visibility="{Binding Source={x:Static p:Settings.Default}, Path=ShipAvgExpVisibility, Converter={StaticResource CvtDataGridColumnVisibility}}"/><TextBlock Text="{Binding ShipAvgExpPerBattle, Converter={StaticResource CvtBattleData}, StringFormat={}{0:f0}}" Visibility="{Binding Source={x:Static p:Settings.Default}, Path=ShipAvgExpVisibility, Converter={StaticResource CvtDataGridColumnVisibility}}"/></StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="3" ClipToBounds="True" Visibility="{Binding Source={x:Static p:Settings.Default}, Path=ShowTierPerformanceStats, Converter={StaticResource BoolToVisibility}}" TextElement.FontSize="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}, Path=EffectiveStatisticsFontSize}"><TextBlock TextAlignment="Center" TextTrimming="CharacterEllipsis"><Run Text="{Binding ShipTier, Converter={StaticResource CvtShipTier}}"/><Run Text=" · "/><Run Text="{Binding TierBattles, Converter={StaticResource CvtBattleData}, StringFormat={}{0:f0}}"/><Run Text="{Binding TierSampleMarker, Mode=OneWay}" Foreground="#D97706"/></TextBlock><TextBlock TextAlignment="Center" TextTrimming="CharacterEllipsis"><Run Text="{Binding TierWinrate, Converter={StaticResource CvtBattleData}, StringFormat={}{0:p2}}" Foreground="{Binding TierWinrate, Converter={StaticResource CvtWinrateColor}}"/><Run Text=" · PR "/><Run Text="{Binding TierPR, Converter={StaticResource CvtBattleData}, StringFormat={}{0:f0}}" Foreground="{Binding TierPR, Converter={StaticResource CvtPRColor}}"/></TextBlock></StackPanel>
                <StackPanel Grid.Column="4" ClipToBounds="True" Visibility="{Binding Source={x:Static p:Settings.Default}, Path=PRVisibility, Converter={StaticResource CvtDataGridColumnVisibility}}" TextElement.FontSize="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}, Path=EffectiveStatisticsFontSize}"><TextBlock Text="{Binding PR, Converter={StaticResource CvtBattleData}, StringFormat={}{0:f0}}" Foreground="{Binding PR, Converter={StaticResource CvtPRColor}}" TextAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ShipPR, Converter={StaticResource CvtBattleData}, StringFormat={}{0:f0}}" Foreground="{Binding ShipPR, Converter={StaticResource CvtPRColor}}" TextAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="TagHeaderTemplate">
            <StackPanel Orientation="Vertical" Width="60" Visibility="{Binding Source={x:Static p:Settings.Default}, Path=TagVisibility, Converter={StaticResource CvtDataGridColumnVisibility}}" HorizontalAlignment="Center">
                <TextBlock Text="{DynamicResource DataGridHeaderTag}" HorizontalAlignment="Center" FontSize="15"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="TagTemplate">
            <StackPanel Orientation="Vertical" Width="60" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding Source={x:Static p:Settings.Default}, Path=TagVisibility, Converter={StaticResource CvtDataGridColumnFadedColor}}">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource CvtTagData}">
                            <Binding Path="AccountWinrate"/>
                            <Binding Path="WeightedWinrate"/>
                            <Binding Path="Battles"/>
                            <Binding Path="IsHidden"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="NameTemplateMirrored">
            <Grid VerticalAlignment="Center" ClipToBounds="True">
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" FontSize="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}, Path=EffectivePlayerFontSize}" Margin="5,0" TextAlignment="Right" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                    <Run Text="{Binding ClanTag, Converter={StaticResource CvtPlayerNamesVisibility}}"/> <Run Text="{Binding Name, Converter={StaticResource CvtPlayerNamesVisibility}}"/> <Run BaselineAlignment="Superscript" FontSize="12" Text="{Binding Karma, Converter={StaticResource CvtBattleData}}"/><Run Text="{Binding WatchStatus, Converter={StaticResource CvtWatchStatusIcon}}"/><Run Text="{Binding Note, Converter={StaticResource CvtNoteIcon}}"/><Run Foreground="#FFD700" Text="{Binding CustomMarkerIcon, Mode=OneWay}"/><Run Foreground="#FF8C00" Text="{Binding RecentEncounterIcon, Mode=OneWay}"/>
                </TextBlock>
                <Grid Grid.Row="1" Margin="5,0" ClipToBounds="True">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}, Path=EffectivePlayerFontSize}" TextAlignment="Right" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"><Run Text="{Binding ShipTier, Converter={StaticResource CvtShipTier}}"/> <Run Text="{Binding ShipName}"/></TextBlock>
                    <utils:ShipTypeIconBadge Grid.Column="1" ShipType="{Binding ShipType}" TintBrush="{Binding Relation, Converter={StaticResource CvtShipRelationBrush}}" Margin="4,0,0,0"/>
                </Grid>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="StatisticsHeaderTemplateMirrored">
            <Grid Margin="-4,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Row="0" Grid.Column="0">
                    <StackPanel Orientation="Vertical" Width="114" Visibility="{Binding Source={x:Static p:Settings.Default}, Path=ShipWinrateVisibility, Converter={StaticResource CvtDataGridColumnVisibility}}">
